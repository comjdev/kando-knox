---
import googleReviews from "../../content/testimonials/google-reviews.json";

// Filter out reviews without text and ensure text is not null
const reviewsWithText = googleReviews.filter(
  (review): review is typeof review & { text: string } => !!review.text
);

// Calculate average length and select reviews of similar length
const avgLength =
  reviewsWithText.reduce((sum, review) => sum + review.text.length, 0) /
  reviewsWithText.length;

// Get reviews within 30% of average length, then shuffle and take 5
const similarLengthReviews = reviewsWithText.filter(
  (review) =>
    review.text.length >= avgLength * 0.7 &&
    review.text.length <= avgLength * 1.3
);
const shuffled = similarLengthReviews.sort(() => 0.5 - Math.random());
const selectedReviews = shuffled.slice(0, 5);
---

<section class="bg-white dark:bg-gray-900">
  <div class="py-8 px-4 mx-auto max-w-7xl text-center lg:py-16 lg:px-6">
    <div class="mx-auto max-w-screen-sm mb-8 lg:mb-16">
      <h2
        class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
      >
        Testimonials
      </h2>
      <p class="font-light text-gray-500 sm:text-xl dark:text-gray-400">
        See what our students and their families have to say about their
        experience at Kando Martial Arts Knox
      </p>
    </div>

    <div
      id="testimonial-carousel"
      class="relative"
      data-carousel="slide"
      data-carousel-interval="7500"
    >
      <div
        class="overflow-hidden relative mx-auto max-w-3xl min-h-[250px] rounded-lg"
      >
        {
          selectedReviews.map((review, index) => (
            <figure
              class={
                index === 0
                  ? "mx-auto w-full max-w-3xl block"
                  : "hidden mx-auto w-full max-w-3xl"
              }
              data-carousel-item
            >
              <blockquote>
                <p class="text-lg font-medium text-gray-900 sm:text-2xl dark:text-white">
                  "{review.text}"
                </p>
              </blockquote>
              <figcaption class="flex justify-center items-center mt-6">
                <div class="flex items-center divide-x-2 divide-gray-500 dark:divide-gray-700">
                  <div class="pr-3 font-medium text-gray-900 dark:text-white">
                    {review.name}
                  </div>
                  <div class="pl-3 text-sm font-light text-gray-500 dark:text-gray-400">
                    Google Reviews
                  </div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="flex justify-center items-center">
        <button
          type="button"
          class="flex justify-center items-center mr-4 h-full cursor-pointer group focus:outline-none"
          data-carousel-prev
        >
          <span
            class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="hidden">Previous</span>
          </span>
        </button>
        <button
          type="button"
          class="flex justify-center items-center h-full cursor-pointer group focus:outline-none"
          data-carousel-next
        >
          <span
            class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="hidden">Next</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Customize carousel transition speed */
  #testimonial-carousel [data-carousel-item] {
    transition:
      transform 1.2s ease-in-out,
      opacity 1.2s ease-in-out;
  }

  /* Adjust this value to change speed: lower = faster, higher = slower */
  /* Examples: 0.3s = fast, 0.6s = medium, 1.2s = slow (current), 1.5s = very slow */
</style>

<script>
  // Flowbite should auto-initialize via Layout.astro script
  // This script just ensures the carousel structure is correct
  if (typeof window !== "undefined") {
    // Ensure first item is visible on initial load
    function ensureFirstItemVisible() {
      const carousel = document.getElementById("testimonial-carousel");
      if (!carousel) return;

      const items = carousel.querySelectorAll("[data-carousel-item]");
      if (items.length > 0) {
        const firstItem = items[0];
        if (firstItem && firstItem.classList.contains("hidden")) {
          firstItem.classList.remove("hidden");
          firstItem.classList.add("block");
        }
      }
    }

    // Run on initial load
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", ensureFirstItemVisible);
    } else {
      ensureFirstItemVisible();
    }

    // Ensure structure is correct after ViewTransitions
    document.addEventListener("astro:page-load", () => {
      setTimeout(ensureFirstItemVisible, 150);
    });
  }
</script>
