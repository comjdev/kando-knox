---
interface Props {
  action?: string;
  trial: {
    cost: number | false;
    value: number;
    unlimitedClasses?: boolean;
    freeGi?: boolean;
    weeks: number;
    copy?: string;
    term?: "program" | "trial";
  };
  title?: string;
}

const { action = "#", trial, title } = Astro.props;
---

<section id="book-trial" class="bg-gray-100 dark:bg-gray-800">
  <div class="pt-8 px-4 mx-auto max-w-7xl sm:pt-16 lg:px-6">
    <div class="mx-auto max-w-screen-sm text-center">
      <h2
        class="mb-4 text-4xl tracking-tight font-extrabold leading-tight text-gray-900 dark:text-white"
      >
        Book Your {trial.weeks} Weeks {
          trial.term === "program" ? "Program" : "Trial"
        }
      </h2>
      <p class="mb-2 font-light text-gray-500 dark:text-gray-400 md:text-lg">
        {
          trial.copy ?? (
            <>
              Experience the benefits of {title} training at Kando Martial Arts
              Knox. Join us for a {trial.weeks} weeks trial and discover how we
              can help you or your child develop confidence, discipline, and
              physical fitness.
            </>
          )
        }
      </p>
    </div>
  </div>

  <div
    class="gap-8 items-center pb-8 px-4 mx-auto max-w-7xl lg:grid lg:grid-cols-2 xl:gap-16 sm:pb-16 sm:pt-8 lg:px-6"
  >
    <div class="mb-4 w-full lg:mb-0">
      <form
        data-form-type="trial"
        method="post"
        action={action}
        class="space-y-6"
        aria-label="Trial booking form"
      >
        {title && <input type="hidden" name="program" value={title} />}
        <div>
          <label
            for="first-name"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300"
          >
            First name
          </label>
          <input
            type="text"
            id="first-name"
            name="first-name"
            aria-label="First name"
            aria-required="true"
            class="block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg shadow-sm bg-gray-50 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
            placeholder="John"
            required
          />
        </div>

        <div>
          <label
            for="last-name"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300"
          >
            Last name
          </label>
          <input
            type="text"
            id="last-name"
            name="last-name"
            class="block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg shadow-sm bg-gray-50 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
            placeholder="Doe"
            required
            aria-label="Last name"
            aria-required="true"
          />
        </div>

        <div>
          <label
            for="email"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300"
          >
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg shadow-sm bg-gray-50 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
            placeholder="name@email.com"
            required
            aria-label="Email address"
            aria-required="true"
          />
        </div>

        <div>
          <label
            for="mobile"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300"
          >
            Mobile
          </label>
          <input
            type="tel"
            id="mobile"
            name="mobile"
            class="block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg shadow-sm bg-gray-50 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
            placeholder="0412 345 678"
            required
            aria-label="Mobile phone number"
            aria-required="true"
          />
        </div>

        <button
          type="submit"
          class="w-full px-5 py-4 text-base mt-4 font-semibold text-center text-white rounded-lg bg-primary-500 hover:bg-primary-600 focus:ring-4 focus:outline-none focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
          aria-label="Submit trial booking form"
        >
          Book a Trial
        </button>
      </form>
    </div>

    <div class="text-gray-500 dark:text-gray-400 sm:text-lg">
      <div class="py-8 mb-6 border-gray-200 dark:border-gray-700">
        <div class="flex">
          <div
            class="flex justify-center items-center mr-4 w-8 h-8 rounded-full bg-primary-400 dark:bg-primary-600 shrink-0"
          >
            <svg
              class="w-6 h-6 text-gray-800 dark:text-white"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
              {trial.weeks} weeks {
                trial.term === "program" ? "Program" : "Trial"
              }
            </h3>
            <p class="mb-2 font-light text-gray-500 dark:text-gray-400">
              Get your first {trial.weeks} weeks of {title} training at Kando Martial
              Arts Knox{
                trial.cost !== false && (
                  <>
                    {" "}
                    for only{" "}
                    <span class="font-bold">${trial.cost}</span>{" "}
                    (${trial.value} Value)
                  </>
                )
              }{"."}
            </p>
          </div>
        </div>

        {
          trial.unlimitedClasses && (
            <div class="flex pt-8">
              <div class="flex justify-center items-center mr-4 w-8 h-8 bg-primary-400 rounded-full dark:bg-primary-600 shrink-0">
                <svg
                  class="w-6 h-6 text-gray-800 dark:text-white"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="M4.5 17H4a1 1 0 0 1-1-1 3 3 0 0 1 3-3h1m0-3.05A2.5 2.5 0 1 1 9 5.5M19.5 17h.5a1 1 0 0 0 1-1 3 3 0 0 0-3-3h-1m0-3.05a2.5 2.5 0 1 0-2-4.45m.5 13.5h-7a1 1 0 0 1-1-1 3 3 0 0 1 3-3h3a3 3 0 0 1 3 3 1 1 0 0 1-1 1Zm-1-9.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z"
                  />
                </svg>
              </div>
              <div>
                <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
                  Unlimited Classes
                </h3>
                <p class="mb-2 font-light text-gray-500 dark:text-gray-400">
                  Enjoy unlimited classes during your {trial.weeks} weeks trial.
                  This is a great way to try out the program and see if it's
                  right for you.
                </p>
              </div>
            </div>
          )
        }

        {
          trial.freeGi && (
            <div class="flex pt-8">
              <div class="flex justify-center items-center mr-4 w-8 h-8 bg-primary-400 rounded-full dark:bg-primary-600 shrink-0">
                <svg
                  class="w-6 h-6 text-gray-800 dark:text-white"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke="currentColor"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5h-.16667c-.86548 0-1.70761.28071-2.4.8L3.5 8l2 3.5L8 10v9h8v-9l2.5 1.5 2-3.5-2.9333-2.2c-.6924-.51929-1.5346-.8-2.4-.8H15M9 5c0 1.5 1.5 3 3 3s3-1.5 3-3M9 5h6"
                  />
                </svg>
              </div>
              <div>
                <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
                  Free Uniform
                </h3>
                <p class="mb-2 font-light  text-gray-500 dark:text-gray-400">
                  Get a free uniform when you book your 4 weeks trial. This
                  starter uniform is worth $80. You can keep it after the trial.
                </p>
              </div>
            </div>
          )
        }

        <p
          class="text-sm border-t border-gray-200 dark:border-gray-700 mt-8 pt-4"
        >
          By opting in, you agree to receive periodic text messages & emails
          from Kando Martial Arts. Your information will never be shared. Reply
          STOP to cancel. Standard rates may apply. View our{" "}
          <a
            href="/terms-of-service"
            class="text-primary-600 hover:underline dark:text-primary-500"
            >Terms of Service</a
          >
          {" & "}
          <a
            href="/privacy-policy"
            class="text-primary-600 hover:underline dark:text-primary-500"
            >Privacy Policy</a
          >.
        </p>
      </div>
    </div>
  </div>
</section>
