---
import OptimizedImage from "./OptimizedImage.astro";

interface Props {
  title: string;
  slug: string;
  description: string;
  date: string;
  image?: string;
  categories?: string[];
}

const { title, slug, description, date, image, categories = [] } = Astro.props;
---

<div
  class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden flex flex-col h-full"
>
  <a href={`/blog/${slug}`}>
    <OptimizedImage
      src={image || "/img/default.jpg"}
      alt={`${title} - Blog post from Kando Martial Arts Knox`}
      class="w-full h-64 object-cover"
      loading="lazy"
      decoding="async"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
    />
  </a>
  <div class="p-4 flex flex-col flex-1">
    {
      categories.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2">
          {categories.map((category) => (
            <span class="bg-primary-100 text-primary-800 text-xs font-semibold px-2.5 py-0.5 rounded dark:bg-primary-200 dark:text-primary-900">
              {category}
            </span>
          ))}
        </div>
      )
    }
    <h2 class="text-2xl font-bold mb-2">
      <a
        href={`/blog/${slug}`}
        class="text-gray-900 dark:text-white hover:text-primary-500 dark:hover:text-primary-400"
      >
        {title}
      </a>
    </h2>
    <p class="text-gray-500 dark:text-gray-400 mb-4 flex-1">
      {description.slice(0, 100)}...
    </p>
    <a
      href={`/blog/${slug}`}
      class="text-primary-500 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 underline mt-auto"
      >Read more</a
    >
  </div>
</div>
