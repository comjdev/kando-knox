---
import { Image, type ImageMetadata } from "astro:assets";
import { getImageAsset } from "../../utils/imageMap";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  sizes?: string;
  width?: number;
  height?: number;
  quality?: number;
  format?: "avif" | "webp" | "png" | "jpg" | "jpeg";
  placeholderColor?: string; // Optional custom placeholder background color
  noBackground?: boolean; // Set to true for transparent images (like logos)
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  decoding = "async",
  sizes,
  width,
  height,
  quality = 80,
  format: requestedFormat = "webp", // Default to WebP for best performance
  placeholderColor = "bg-gray-200 dark:bg-gray-700", // Default placeholder color
  noBackground = false, // Default to showing background for loading indicator
} = Astro.props;

// If src is already an ImageMetadata object (imported asset), use it directly
// Otherwise, try to resolve it from the imageMap
let finalSrc: ImageMetadata | string;
let finalIsAsset: boolean;

if (typeof src === "object" && "src" in src) {
  // src is already an ImageMetadata object - use it directly
  finalSrc = src as ImageMetadata;
  finalIsAsset = true;
} else if (typeof src === "string") {
  // src is a string path - try to resolve it from imageMap
  const imageAsset = getImageAsset(src);
  if (typeof imageAsset === "object" && "src" in imageAsset) {
    finalSrc = imageAsset;
    finalIsAsset = true;
  } else {
    finalSrc = imageAsset as string;
    finalIsAsset = false;
  }
} else {
  // Fallback
  finalSrc = src as string;
  finalIsAsset = false;
}

// If source is already an ImageMetadata (imported asset), check if it's AVIF
// and preserve the format if it's already optimized (AVIF or WebP)
let format = requestedFormat;
if (finalIsAsset && typeof finalSrc === "object" && "src" in finalSrc) {
  const srcString = finalSrc.src?.toString() || "";
  // If the source file is already AVIF, preserve it
  if (srcString.includes(".avif") || srcString.endsWith(".avif")) {
    format = "avif";
  }
  // If the source file is already WebP, preserve it
  else if (srcString.includes(".webp") || srcString.endsWith(".webp")) {
    format = "webp";
  }
}

// Check if className contains a height class (h-*)
const hasHeightClass = /h-\d+|h-full|h-screen|h-auto/.test(className);

// Calculate display width based on sizes attribute for responsive images
// Astro's Image component will automatically generate srcset (1x, 2x) based on this width
let displayWidth: number | undefined;
let displayHeight: number | undefined;

if (finalIsAsset && typeof finalSrc === "object" && "src" in finalSrc) {
  if (sizes && !width) {
    // Parse sizes attribute to determine max display width
    // Examples:
    // "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" -> ~400px (33vw of 1280px desktop)
    // "(max-width: 768px) 50vw, 400px" -> 400px
    // "100vw" -> 1920px (full width)
    
    // Extract all size values from sizes and use the largest reasonable one
    // This handles cases like "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
    const sizeValues: number[] = [];
    const vwMatches = sizes.matchAll(/(\d+(?:\.\d+)?)\s*vw/g);
    const pxMatches = sizes.matchAll(/(\d+(?:\.\d+)?)\s*px/g);
    
    // Calculate vw values assuming 1280px viewport (common desktop size)
    for (const match of vwMatches) {
      const value = parseFloat(match[1]);
      sizeValues.push(Math.ceil((value / 100) * 1280));
    }
    
    // Add px values directly
    for (const match of pxMatches) {
      sizeValues.push(parseFloat(match[1]));
    }
    
    if (sizeValues.length > 0) {
      // Use the maximum value, but cap at 800px for cards (2x for 400px display = 800px)
      // This ensures we generate appropriate srcset without over-sizing
      displayWidth = Math.min(Math.max(...sizeValues), 800);
      
      // For very small sizes, ensure we have at least 400px for quality
      if (displayWidth < 400) {
        displayWidth = 400;
      }
    } else {
      // Fallback: use common card width
      displayWidth = 800;
    }
    
    // Calculate height maintaining aspect ratio if original dimensions available
    if (displayWidth && finalSrc.width && finalSrc.height) {
      displayHeight = Math.round((displayWidth / finalSrc.width) * finalSrc.height);
    }
  } else if (width) {
    // If width is explicitly provided, use it (Astro will generate 1x and 2x srcset)
    displayWidth = width;
    displayHeight = height;
  }
}
---

{
  noBackground ? (
    // For transparent images (like logos), render without background wrapper
    finalIsAsset ? (
      <Image
        src={finalSrc as ImageMetadata}
        alt={alt}
        class={className}
        loading={loading}
        decoding={decoding}
        sizes={sizes}
        width={displayWidth || width}
        height={displayHeight || height}
        quality={quality}
        format={format}
      />
    ) : (
      <img
        src={finalSrc as string}
        alt={alt}
        class={className}
        loading={loading}
        decoding={decoding}
        sizes={sizes}
        width={width}
        height={height}
      />
    )
  ) : (
    // For regular images, use wrapper with background color
    <div
      class={`optimized-image-wrapper ${placeholderColor} ${className} relative overflow-hidden`}
    >
      {finalIsAsset ? (
        <Image
          src={finalSrc as ImageMetadata}
          alt={alt}
          class={`optimized-image-main relative z-10 w-full ${hasHeightClass ? "h-full object-cover" : ""}`}
          loading={loading}
          decoding={decoding}
          sizes={sizes}
          width={displayWidth || width}
          height={displayHeight || height}
          quality={quality}
          format={format}
        />
      ) : (
        <img
          src={finalSrc as string}
          alt={alt}
          class={`optimized-image-main relative z-10 w-full ${hasHeightClass ? "h-full object-cover" : ""}`}
          loading={loading}
          decoding={decoding}
          sizes={sizes}
          width={width}
          height={height}
        />
      )}
    </div>
  )
}

<style>
  .optimized-image-wrapper {
    position: relative;
    display: block;
    /* Ensure wrapper fits image dimensions exactly when no explicit height */
    line-height: 0;
    /* Ensure border-radius clips background */
    overflow: hidden;
    /* Ensure wrapper matches image size exactly */
    width: 100%;
  }

  .optimized-image-main {
    display: block;
    width: 100%;
    /* height: auto maintains aspect ratio when no height constraint is set */
    height: auto;
    /* Ensure image respects border-radius */
    border-radius: inherit;
  }

  /* When wrapper has height constraint, image should fill it */
  .optimized-image-wrapper[class*="h-"] .optimized-image-main,
  .optimized-image-wrapper[class*="h-full"] .optimized-image-main,
  .optimized-image-wrapper[class*="h-screen"] .optimized-image-main {
    height: 100%;
    object-fit: cover;
  }
</style>
