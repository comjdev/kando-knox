---
import { Image, type ImageMetadata } from "astro:assets";
import { getImageAsset } from "../../utils/imageMap";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  sizes?: string;
  width?: number;
  height?: number;
  quality?: number;
  format?: "avif" | "webp" | "png" | "jpg" | "jpeg";
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  decoding = "async",
  sizes,
  width,
  height,
  quality = 80,
  format = "webp", // Default to WebP for best performance
} = Astro.props;

// Resolve image path to asset if available
const imageAsset = getImageAsset(typeof src === "string" ? src : undefined);

// Check if we have an asset import (ImageMetadata)
const isAsset = typeof imageAsset === "object" && "src" in imageAsset;

// Use resolved asset or original src
const finalSrc = isAsset
  ? imageAsset
  : typeof src === "object"
    ? src
    : imageAsset;
const finalIsAsset = typeof finalSrc === "object" && "src" in finalSrc;
---

{
  finalIsAsset ? (
    <Image
      src={finalSrc as ImageMetadata}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      sizes={sizes}
      width={width}
      height={height}
      quality={quality}
      format={format}
    />
  ) : (
    <img
      src={finalSrc as string}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      sizes={sizes}
      width={width}
      height={height}
    />
  )
}
