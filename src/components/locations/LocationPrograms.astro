---
import { PROGRAMS } from "../../config";
import OptimizedImage from "../shared/OptimizedImage.astro";

interface Props {
  classes: Array<{
    id: string;
    heading: string;
    description: string;
  }>;
  locationName: string;
}

const { classes, locationName } = Astro.props;

// Load all program content files
const programFiles = Object.values(
  import.meta.glob("../../content/program/*.json", { eager: true })
).map((file: any) => file.default);

// Helper function to get program data from id
function getProgramData(id: string) {
  const program = PROGRAMS.find((p) => p.href.includes(id));
  if (!program) return { href: "#", image: null };

  // Extract slug from href (e.g., "/programs/pre-school-martial-arts-karate-knox" -> "pre-school-martial-arts-karate-knox")
  const slug = program.href.replace("/programs/", "");
  const programContent = programFiles.find((p: any) => p.slug === slug);

  return {
    href: program.href,
    image: programContent?.image || null,
  };
}
---

<section class="bg-white dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h2
      class="mb-12 text-4xl md:text-5xl font-extrabold text-center text-gray-900 dark:text-white"
    >
      Our Karate Programs
    </h2>
    <p
      class="max-w-4xl mx-auto mb-6 font-light text-gray-500 md:text-lg dark:text-gray-400 text-center"
    >
      Our karate programs are designed to help students learn the art of karate
      in a safe and supportive environment. We proudly serve families from
      {locationName} and across the Knox Council area, offering classes for all ages
      and skill levels, from beginners to advanced students.
    </p>
    {
      classes.map((classItem, index) => {
        const programData = getProgramData(classItem.id);
        const href = programData.href;
        const image = programData.image || "/img/default.jpg";
        const isEven = index % 2 === 0;

        return (
          <div class="bg-white dark:bg-gray-900">
            <div class="gap-8 items-center py-8 px-4 mx-auto max-w-7xl xl:gap-16 md:grid md:grid-cols-2 sm:py-8 lg:px-6">
              {isEven ? (
                <>
                  <OptimizedImage
                    src={image}
                    alt={`${classItem.heading} image`}
                    class="w-full rounded-lg"
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 768px) 100vw, 50vw"
                  />
                  <div class="mt-4 md:mt-0">
                    <h3 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
                      {classItem.heading}
                    </h3>
                    <p class="mb-6 font-light text-gray-500 md:text-lg dark:text-gray-400">
                      {classItem.description}
                    </p>
                    <a
                      href={href}
                      class="inline-flex items-center text-white bg-primary-500 hover:bg-primary-600 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:focus:ring-primary-900"
                    >
                      Learn more
                      <svg
                        class="ml-2 -mr-1 w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </a>
                  </div>
                </>
              ) : (
                <>
                  <div class="mt-4 md:mt-0">
                    <h3 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
                      {classItem.heading}
                    </h3>
                    <p class="mb-6 font-light text-gray-500 md:text-lg dark:text-gray-400">
                      {classItem.description}
                    </p>
                    <a
                      href={href}
                      class="inline-flex items-center text-white bg-primary-500  focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:focus:ring-primary-900"
                    >
                      Learn more
                      <svg
                        class="ml-2 -mr-1 w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </a>
                  </div>
                  <OptimizedImage
                    src={image}
                    alt={`${classItem.heading} image`}
                    class="w-full rounded-lg"
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 768px) 100vw, 50vw"
                  />
                </>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
