---
interface Props {
  whyChooseUs: {
    heading: string;
    description: string;
    benefits: Array<{
      icon: string;
      heading: string;
      description: string;
    }>;
  };
}

const { whyChooseUs } = Astro.props;

// Helper function to check if icon is an emoji
function isEmoji(icon: string): boolean {
  return /[\u{1F300}-\u{1F9FF}]/u.test(icon);
}
---

<section class="bg-white dark:bg-gray-900">
  <div class="py-8 px-4 mx-auto max-w-7xl text-center sm:py-16 lg:px-6">
    <h2
      class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
    >
      {whyChooseUs.heading}
    </h2>
    <p class="text-gray-500 sm:text-xl dark:text-gray-400">
      {whyChooseUs.description}
    </p>
    <div
      class="mt-8 lg:mt-12 space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
    >
      {
        whyChooseUs.benefits.map((benefit) => (
          <div>
            {isEmoji(benefit.icon) ? (
              <div class="mx-auto mb-4 w-12 h-12 text-4xl flex items-center justify-center">
                {benefit.icon}
              </div>
            ) : (
              <svg
                class="mx-auto mb-4 w-12 h-12 text-primary-600 dark:text-primary-500"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  d="M6.625 2.655A9 9 0 0119 11a1 1 0 11-2 0 7 7 0 00-9.625-6.492 1 1 0 11-.75-1.853zM4.662 4.959A1 1 0 014.75 6.37 6.97 6.97 0 003 11a1 1 0 11-2 0 8.97 8.97 0 012.25-5.953 1 1 0 011.412-.088z"
                  clip-rule="evenodd"
                />
                <path
                  fill-rule="evenodd"
                  d="M5 11a5 5 0 1110 0 1 1 0 11-2 0 3 3 0 10-6 0c0 1.677-.345 3.276-.968 4.729a1 1 0 11-1.838-.789A9.964 9.964 0 005 11zm8.921 2.012a1 1 0 01.831 1.145 19.86 19.86 0 01-.545 2.436 1 1 0 11-1.92-.558c.207-.713.371-1.445.49-2.192a1 1 0 011.144-.83z"
                  clip-rule="evenodd"
                />
                <path
                  fill-rule="evenodd"
                  d="M10 10a1 1 0 011 1c0 2.236-.46 4.368-1.29 6.304a1 1 0 01-1.838-.789A13.952 13.952 0 009 11a1 1 0 011-1z"
                  clip-rule="evenodd"
                />
              </svg>
            )}
            <h3 class="mb-2 text-xl font-bold dark:text-white">
              {benefit.heading}
            </h3>
            <p class="mb-4 text-gray-500 dark:text-gray-400">
              {benefit.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
