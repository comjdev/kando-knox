---
import heroSliderData from "../../content/heroSlider.json";
import { getImageAsset } from "../../utils/imageMap";
import { Image } from "astro:assets";

interface Slide {
  image: string;
  title: string;
  name: string;
  description: string;
  buttonText?: string;
  buttonLink?: string;
  dojo?: string;
}

const slides: Slide[] = heroSliderData;

// Map slides to include optimized image assets
const slidesWithAssets = slides.map((slide) => {
  const imageAsset = getImageAsset(slide.image);
  return {
    ...slide,
    imageAsset,
  };
});
---

<div
  class="hero-carousel-wrapper relative z-0 w-full bg-[#111111]"
  style="height: calc(100dvh - 96px);"
>
  <div class="carousel relative w-full h-full overflow-hidden z-0">
    <div class="list">
      {
        slidesWithAssets.map((slide) => {
          // Get optimized image URL from asset
          const imageUrl =
            typeof slide.imageAsset === "object"
              ? slide.imageAsset.src
              : slide.image;

          return (
            <div
              class="item absolute rounded-[20px] overflow-hidden bg-cover bg-center shadow-[0_25px_50px_rgba(0,0,0,0.7)] z-10 transition-all"
              style={`background-image: url(${imageUrl});`}
            >
              <div class="content absolute text-left text-white z-[3] left-0 w-full p-2.5 transition-all">
                <div
                  class="title relative uppercase font-bold leading-none mb-2.5 text-white text-xs transition-all"
                  data-dojo={slide.dojo || ""}
                >
                  {slide.title}
                </div>
                <div class="name uppercase font-medium leading-none mb-2.5 text-[10px] text-primary-500 transition-all">
                  {slide.name}
                </div>
                <div class="des text-base font-normal opacity-0 hidden transition-all">
                  {slide.description}
                </div>
                {slide.buttonText && slide.buttonLink ? (
                  <a
                    href={slide.buttonLink}
                    class="hero-button hidden mt-5 px-6 py-3 bg-primary-500 text-white no-underline rounded font-medium transition-all hover:bg-[#a67a0b] hover:-translate-y-0.5"
                    aria-label={slide.buttonText}
                  >
                    {slide.buttonText}
                  </a>
                ) : (
                  ""
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <!--next prev button-->
    <div
      class="arrows absolute bottom-[50px] z-20 flex gap-[5%] items-center"
      style="left: var(--left-position); width: calc(100% - var(--left-position) - 2%);"
    >
      <button
        class="prev w-10 h-10 min-w-10 min-h-10 rounded-full border-2 border-white text-white bg-transparent outline-none text-[25px] font-bold transition-all cursor-pointer flex items-center justify-center hover:border-white hover:text-white hover:bg-transparent"
        aria-label="Previous slide"
        type="button"
      >
        <svg
          class="w-6 h-6 text-white"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 12h14M5 12l4-4m-4 4 4 4"></path>
        </svg>
      </button>
      <button
        class="next w-10 h-10 min-w-10 min-h-10 rounded-full border-2 border-white text-white bg-transparent outline-none text-[25px] font-bold transition-all cursor-pointer flex items-center justify-center hover:border-white hover:text-white hover:bg-transparent"
        aria-label="Next slide"
        type="button"
      >
        <svg
          class="w-6 h-6 text-white"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 12H5m14 0-4 4m4-4-4-4"></path>
        </svg>
      </button>
    </div>

    <!-- time running -->
    <div
      class="timeRunning absolute z-[200] w-0 h-1 bg-primary-500 left-0 top-0 pointer-events-none"
    >
    </div>
  </div>
</div>

<style>
  .hero-carousel-wrapper {
    --left-position: 55%;
    --transition-time: 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Item positioning and overlay */
  .carousel .list .item {
    width: 180px;
    height: 250px;
    bottom: 150px;
    left: calc(var(--left-position) + 3%);
    transform: translate(0, 0px);
    transition: all var(--transition-time);
  }

  .carousel .list .item::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    background-color: rgba(33, 33, 33, 0.5);
    z-index: 1;
  }

  /* Active slides (first two) */
  .carousel .list .item:nth-child(1),
  .carousel .list .item:nth-child(2) {
    bottom: 0px;
    left: 0;
    border-radius: 0;
    transform: translate(0, 0px);
    width: 100%;
    height: 100%;
  }

  /* Preview slides positioning */
  .carousel .list .item:nth-child(3) {
    left: var(--left-position);
  }

  .carousel .list .item:nth-child(4) {
    transition-delay: 0.1s;
    left: calc(var(--left-position) + 200px);
  }

  .carousel .list .item:nth-child(5) {
    transition-delay: 0.2s;
    left: calc(var(--left-position) + 400px);
  }

  .carousel .list .item:nth-child(6) {
    transition-delay: 0.3s;
    left: calc(var(--left-position) + 600px);
  }

  .carousel .list .item:nth-child(n + 7) {
    transition-delay: 0.4s;
    left: calc(var(--left-position) + 800px);
  }

  /* Content positioning for preview slides */
  .list .item .content {
    top: 100%;
    transform: translateY(-100%);
    transition: all var(--transition-time);
  }

  /* Content positioning for active slides */
  .list .item:nth-child(1) .content,
  .list .item:nth-child(2) .content {
    transform: translateY(-50%);
    left: 100px;
    width: 600px;
    top: 50%;
    padding: 0;
  }

  /* Responsive adjustments for smaller screens */
  @media (max-width: 768px) {
    .list .item:nth-child(1) .content,
    .list .item:nth-child(2) .content {
      left: 20px;
      width: calc(100% - 40px);
      top: 40%;
      padding: 0;
    }

    .list .item:nth-child(1) .content .title,
    .list .item:nth-child(2) .content .title {
      font-size: 24px;
      margin-bottom: 16px;
      word-wrap: break-word;
      overflow-wrap: break-word;
      line-height: 1.2;
      max-width: 100%;
    }

    .list .item:nth-child(1) .content .name,
    .list .item:nth-child(2) .content .name {
      font-size: 16px;
      margin-bottom: 16px;
    }

    .list .item:nth-child(1) .content .des,
    .list .item:nth-child(2) .content .des {
      font-size: 14px;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .list .item:nth-child(1) .content,
    .list .item:nth-child(2) .content {
      left: 16px;
      width: calc(100% - 32px);
      top: 35%;
    }

    .list .item:nth-child(1) .content .title,
    .list .item:nth-child(2) .content .title {
      font-size: 20px;
      margin-bottom: 12px;
      word-wrap: break-word;
      overflow-wrap: break-word;
      line-height: 1.2;
      max-width: 100%;
    }

    .list .item:nth-child(1) .content .name,
    .list .item:nth-child(2) .content .name {
      font-size: 14px;
      margin-bottom: 12px;
    }

    .list .item:nth-child(1) .content .des,
    .list .item:nth-child(2) .content .des {
      font-size: 13px;
    }
  }

  /* Title base styles - allow wrapping */
  .content .title {
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal;
    max-width: 100%;
    line-height: 1.2;
  }

  /* Title pseudo-elements */
  .content .title::before {
    content: "";
    display: block;
    height: 1px;
    width: 20px;
    background-color: #fff;
    margin-bottom: 10px;
  }

  .content .title::after {
    content: attr(data-dojo);
    color: #fff;
    font-size: 12px;
    position: absolute;
    top: -20px;
    left: 0px;
    z-index: 2;
    font-weight: 400;
  }

  /* Active slide title styles */
  .list .item:nth-child(1) .content .title::before,
  .list .item:nth-child(2) .content .title::before {
    width: 50px;
    height: 3px;
    margin-bottom: 20px;
  }

  .list .item:nth-child(1) .content .title::after,
  .list .item:nth-child(2) .content .title::after {
    font-size: 14px;
    top: -30px;
    left: 0px;
  }

  .list .item:nth-child(1) .content .title,
  .list .item:nth-child(2) .content .title {
    font-size: 30px;
    margin-bottom: 20px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    line-height: 1.2;
    max-width: 100%;
  }

  .list .item:nth-child(1) .content .name,
  .list .item:nth-child(2) .content .name {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .list .item:nth-child(1) .content .des,
  .list .item:nth-child(2) .content .des {
    font-size: 16px;
    opacity: 1;
    display: block;
    width: 400px;
  }

  /* Show button on active slides */
  .list .item:nth-child(1) .content .hero-button,
  .list .item:nth-child(2) .content .hero-button {
    display: inline-block;
  }

  /* Progress bar container */
  .progress-bar-container {
    width: 60%;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 20px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    width: 100%;
    background-color: var(--color-primary-500, #c39519);
    transition: all var(--transition-time);
  }

  /* Time running animation */
  .carousel .timeRunning {
    width: 0%;
    animation: runningTime 7s linear 1 forwards;
  }

  @keyframes runningTime {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  @keyframes animate {
    from {
      opacity: 0;
      transform: translate(0, 100px);
      filter: blur(33px);
    }

    to {
      opacity: 1;
      transform: translate(0);
      filter: blur(0);
    }
  }
</style>

<script>
  // Use global state to persist across page navigations
  if (typeof window !== "undefined" && !window.__heroSlider) {
    window.__heroSlider = {
      initialized: false,
      nextBtn: null,
      prevBtn: null,
      carousel: null,
      list: null,
      items: [],
      runningTimeBar: null,
      progressBar: null,
      transitionTimeout: null,
      autoNextTimeout: null,
      nextHandler: null,
      prevHandler: null,
    };
  }

  const state = window.__heroSlider;

  // Timing configurations
  const TIME_RUNNING = 1500; // Animation duration for the transition
  const TIME_AUTO_NEXT = 4500; // Auto-slide duration

  // Initialize slider function
  function initializeSlider(showErrors = false) {
    // Check if elements exist
    state.nextBtn = document.querySelector(".next");
    state.prevBtn = document.querySelector(".prev");
    state.carousel = document.querySelector(".carousel");
    state.list = document.querySelector(".list");
    state.runningTimeBar = document.querySelector(".carousel .timeRunning");

    // Validate all required elements exist
    if (
      !state.nextBtn ||
      !state.prevBtn ||
      !state.carousel ||
      !state.list ||
      !state.runningTimeBar
    ) {
      if (showErrors) {
        console.error("[HeroSlider] Missing required DOM elements. Found:", {
          nextBtn: !!state.nextBtn,
          prevBtn: !!state.prevBtn,
          carousel: !!state.carousel,
          list: !!state.list,
          runningTimeBar: !!state.runningTimeBar,
        });
      }
      return false;
    }

    // Get items array
    state.items = Array.from(document.querySelectorAll(".item"));
    if (state.items.length === 0) {
      if (showErrors) {
        console.error("[HeroSlider] No slider items found");
      }
      return false;
    }

    // Create and append the progress bar if it doesn't exist
    const arrowsDiv = document.querySelector(".arrows");
    if (!arrowsDiv) {
      if (showErrors) {
        console.error("[HeroSlider] Arrows container not found");
      }
      return false;
    }

    // Check if progress bar already exists
    let progressBarContainer = arrowsDiv.querySelector(
      ".progress-bar-container"
    );
    if (!progressBarContainer) {
      progressBarContainer = document.createElement("div");
      progressBarContainer.className = "progress-bar-container";

      const progressBar = document.createElement("div");
      progressBar.className = "progress-bar";

      progressBarContainer.appendChild(progressBar);
      arrowsDiv.appendChild(progressBarContainer);
      state.progressBar = progressBar;
    } else {
      state.progressBar = progressBarContainer.querySelector(".progress-bar");
    }

    // Remove old event listeners if they exist
    if (state.nextHandler) {
      state.nextBtn.removeEventListener("click", state.nextHandler);
    }
    if (state.prevHandler) {
      state.prevBtn.removeEventListener("click", state.prevHandler);
    }

    // Create new handlers - stop propagation for user clicks to prevent interfering with dropdown
    state.nextHandler = (event) => {
      if (event && event.isTrusted) {
        // Only stop propagation for real user clicks, not programmatic calls
        event.stopPropagation();
      }
      handleSliderNavigation("next");
    };
    state.prevHandler = (event) => {
      if (event && event.isTrusted) {
        // Only stop propagation for real user clicks, not programmatic calls
        event.stopPropagation();
      }
      handleSliderNavigation("prev");
    };

    // Add event listeners
    state.nextBtn.addEventListener("click", state.nextHandler);
    state.prevBtn.addEventListener("click", state.prevHandler);

    // Clear any existing timeouts
    if (state.transitionTimeout) {
      clearTimeout(state.transitionTimeout);
    }
    if (state.autoNextTimeout) {
      clearTimeout(state.autoNextTimeout);
    }

    // Start the initial running time animation and progress bar
    resetAnimation();
    afterSlideChange();

    state.initialized = true;
    console.log("[HeroSlider] Initialized successfully");
    return true;
  }

  // Cleanup function
  function cleanupSlider() {
    if (state.nextHandler && state.nextBtn) {
      state.nextBtn.removeEventListener("click", state.nextHandler);
      state.nextHandler = null;
    }
    if (state.prevHandler && state.prevBtn) {
      state.prevBtn.removeEventListener("click", state.prevHandler);
      state.prevHandler = null;
    }
    if (state.transitionTimeout) {
      clearTimeout(state.transitionTimeout);
      state.transitionTimeout = null;
    }
    if (state.autoNextTimeout) {
      clearTimeout(state.autoNextTimeout);
      state.autoNextTimeout = null;
    }
    state.initialized = false;
  }

  // Resets the running time animation
  function resetAnimation() {
    if (!state.runningTimeBar) {
      console.error("[HeroSlider] Running time bar not found");
      return;
    }
    state.runningTimeBar.style.animation = "none"; // Remove current animation
    state.runningTimeBar.offsetHeight; // Trigger reflow to restart animation
    state.runningTimeBar.style.animation = `runningTime ${
      TIME_AUTO_NEXT / 1000
    }s linear forwards`; // Restart animation
  }

  // Handles slider navigation (next/prev)
  function handleSliderNavigation(direction) {
    if (!state.list || !state.carousel) {
      console.error("[HeroSlider] List or carousel not found");
      return;
    }

    const sliderItems = state.list.querySelectorAll(".item"); // Get all current items in the list

    if (sliderItems.length === 0) {
      console.error("[HeroSlider] No slider items found");
      return;
    }

    if (direction === "next") {
      state.list.appendChild(sliderItems[0]); // Move the first item to the end of the list
      state.carousel.classList.add("next"); // Add the "next" class for transition
    } else if (direction === "prev") {
      state.list.prepend(sliderItems[sliderItems.length - 1]); // Move the last item to the start of the list
      state.carousel.classList.add("prev"); // Add the "prev" class for transition
    }

    afterSlideChange(); // Update progress bar and reset state
  }

  // Stop event propagation for slider buttons to prevent interfering with other click handlers
  function stopPropagation(event) {
    if (event && event.stopPropagation) {
      event.stopPropagation();
    }
  }

  // Updates after slide change
  function afterSlideChange() {
    updateProgressBar();
    resetCarouselState();
  }

  // Updates the progress bar based on the active slide index
  function updateProgressBar() {
    if (!state.progressBar || !state.list || state.items.length === 0) {
      return;
    }

    const totalSlides = state.items.length;
    const sliderItems = Array.from(state.list.querySelectorAll(".item"));

    if (sliderItems.length === 0) {
      return;
    }

    // Find the index of the first visible item in the original items array
    const firstVisibleItem = sliderItems[0];
    const originalIndex = state.items.findIndex(
      (item) => item === firstVisibleItem
    );
    const activeItem = originalIndex >= 0 ? originalIndex + 1 : 1;

    const progressPercentage = (activeItem / totalSlides) * 100;
    state.progressBar.style.width = `${progressPercentage}%`;
  }

  // Resets the carousel state after navigation
  function resetCarouselState() {
    if (!state.carousel || !state.nextBtn) {
      return;
    }

    // Clear existing timeouts for transitions and auto-slide
    if (state.transitionTimeout) {
      clearTimeout(state.transitionTimeout);
    }
    if (state.autoNextTimeout) {
      clearTimeout(state.autoNextTimeout);
    }

    // Remove the transition class after the animation duration
    state.transitionTimeout = setTimeout(() => {
      if (state.carousel) {
        state.carousel.classList.remove("next");
        state.carousel.classList.remove("prev");
      }
    }, TIME_RUNNING);

    // Restart the auto-slide timer
    state.autoNextTimeout = setTimeout(() => {
      if (state.nextBtn && state.initialized) {
        // Call the handler directly instead of triggering a click event
        // This prevents the click from bubbling and closing the dropdown
        handleSliderNavigation("next");
      }
    }, TIME_AUTO_NEXT);

    // Reset the running time bar animation
    resetAnimation();
  }

  // Retry initialization with exponential backoff
  function retryInitialization(maxAttempts = 10, attempt = 1) {
    // Check if hero carousel wrapper exists (only on homepage)
    const heroWrapper = document.querySelector(".hero-carousel-wrapper");
    if (!heroWrapper) {
      // Not on homepage, don't initialize (this is normal)
      return;
    }

    // Only show errors on the last attempt
    const showErrors = attempt === maxAttempts;
    if (initializeSlider(showErrors)) {
      return; // Success
    }

    if (attempt < maxAttempts) {
      // Exponential backoff: 50ms, 100ms, 200ms, 400ms, etc. (max 800ms)
      const delay = Math.min(50 * Math.pow(2, attempt - 1), 800);
      setTimeout(() => {
        retryInitialization(maxAttempts, attempt + 1);
      }, delay);
    } else {
      console.error(
        `[HeroSlider] Initialization failed after ${maxAttempts} attempts. Hero slider may not be available on this page.`
      );
    }
  }

  // Initialize on load and page transitions
  if (typeof window !== "undefined") {
    // Function to initialize or reinitialize
    function initOrReinit() {
      // Cleanup first if already initialized
      if (state.initialized) {
        cleanupSlider();
      }

      // Use requestAnimationFrame to ensure DOM is ready, then retry
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          retryInitialization();
        });
      });
    }

    // Initialize on DOM ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initOrReinit);
    } else {
      initOrReinit();
    }

    // Reinitialize on Astro page load (ViewTransitions)
    document.addEventListener("astro:page-load", () => {
      // Reset element references
      state.nextBtn = null;
      state.prevBtn = null;
      state.carousel = null;
      state.list = null;
      state.items = [];
      state.runningTimeBar = null;
      state.progressBar = null;

      // Wait for ViewTransitions to complete
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          retryInitialization();
        });
      });
    });

    // Also check before page swap to cleanup
    document.addEventListener("astro:before-swap", () => {
      cleanupSlider();
    });
  }
</script>
