---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header";
import "../styles/global.css";
import { SITE_CONFIG } from "../config";
import Footer from "../components/Footer.astro";
import SnowParticles from "../components/shared/SnowParticles.astro";
import Schema from "../components/shared/Schema.astro";
import SEO from "../components/shared/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  nofollow?: boolean;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
}

const {
  title,
  description,
  image,
  url,
  type,
  publishedTime,
  modifiedTime,
  author,
  noindex,
  nofollow,
  schema,
  schemas,
} = Astro.props;
// If title is provided, use it directly (it should already include the suffix)
// Otherwise, use the site title with suffix
import { generatePageTitle } from "../utils/titles";
const pageTitle = title || generatePageTitle(SITE_CONFIG.title, ["Karate", "BJJ"]);
const pageDescription = description || SITE_CONFIG.description;

// Snow effect is now handled client-side in SnowParticles component
---

<!doctype html>
<html lang="en-AU" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    {/* Resource Hints for Performance - Critical for faster loading */}
    {/* Preconnect to Google Fonts (early connection for faster font loading) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    {/* Preconnect to Google Analytics (early connection) */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    {/* Google Analytics - Deferred for better performance */}
    {SITE_CONFIG.googleAnalyticsId && SITE_CONFIG.googleAnalyticsId !== "G-XXXXXXXXXX" && (
      <>
        <script
          defer
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE_CONFIG.googleAnalyticsId}`}
        />
        {/* Inline GA config - loads after gtag.js via defer */}
        <script
          is:inline
          define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}
        >
          // Initialize GA after gtag.js loads (deferred)
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          // Wait for DOM and gtag.js to be ready
          function initGA() {
            if (window.gtag) {
              gtag("js", new Date());
              gtag("config", gaId);
            } else {
              // gtag.js not loaded yet, wait a bit
              setTimeout(initGA, 50);
            }
          }
          // Start initialization when DOM is ready (non-blocking)
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initGA);
          } else {
            // Use requestIdleCallback for non-blocking execution
            if (window.requestIdleCallback) {
              window.requestIdleCallback(initGA, { timeout: 1000 });
            } else {
              setTimeout(initGA, 100);
            }
          }
        </script>
      </>
    )}
    <script is:inline>
      // CRITICAL: Create scheduler stub IMMEDIATELY, before any other scripts run
      // This must execute synchronously to prevent ClientRouter from trying to set unstable_now on undefined
      (function() {
        'use strict';
        if (typeof window === 'undefined') return;
        
        // Ensure performance API exists FIRST
        if (!window.performance || !window.performance.now) {
          if (!window.performance) window.performance = {};
          window.performance.now = function() {
            return Date.now();
          };
        }
        
        // CRITICAL: Create scheduler stub IMMEDIATELY (synchronously)
        // This must exist before ClientRouter's JavaScript executes
        if (!window.__ASTRO_SCHEDULER_STUB__) {
          window.__ASTRO_SCHEDULER_STUB__ = {
            unstable_now: function() {
              return window.performance.now();
            }
          };
        }
        
        // CRITICAL: Make scheduler stub available globally as window.scheduler
        // ClientRouter and React's scheduler module might look for window.scheduler
        if (!window.scheduler) {
          window.scheduler = window.__ASTRO_SCHEDULER_STUB__;
        }
      })();
      
      // React/ViewTransitions Compatibility Fix
      //
      // The Issue:
      // - React 18's scheduler uses unstable_now
      // - ViewTransitions (ClientRouter) also needs unstable_now
      // - ClientRouter's JavaScript tries to set unstable_now on undefined before our fix runs
      //
      // The Solution:
      // - Scheduler stub created IMMEDIATELY above (synchronously)
      // - ClientRouter loads immediately (small, ~7KB)
      // - React loads lazily (client:idle, ~44KB)
      // - This polyfill ensures performance.now() and requestIdleCallback exist
      //
      // User Experience:
      // - Links work immediately (HTML, no JS needed)
      // - Smooth transitions after ClientRouter loads (~50ms)
      // - Interactive features after React loads (~100-500ms)
      (function() {
        'use strict';
        if (typeof window === 'undefined') return;
        
        const startTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Script execution started at:', startTime, 'ms');
        
        // Ensure performance API exists
        if (!window.performance?.now) {
          if (!window.performance) window.performance = {};
          window.performance.now = function() {
            return Date.now();
          };
          console.debug('[Scheduler Fix] Created performance.now polyfill');
        }
        
        // Polyfill requestIdleCallback for older browsers
        if (!window.requestIdleCallback) {
          window.requestIdleCallback = function(callback) {
            return setTimeout(function() {
              callback({
                didTimeout: false,
                timeRemaining: function() {
                  return Math.max(0, 50);
                }
              });
            }, 1);
          };
          window.cancelIdleCallback = function(id) {
            clearTimeout(id);
          };
        }
        
        // Get the scheduler stub (should already exist from the immediate creation above)
        const schedulerStub = window.__ASTRO_SCHEDULER_STUB__;
        const stubCheckTime = performance.now ? performance.now() : Date.now();
        
        if (schedulerStub) {
          console.debug('[Scheduler Fix] Scheduler stub found at:', stubCheckTime, 'ms (elapsed:', (stubCheckTime - startTime).toFixed(2), 'ms)');
          
          // Ensure unstable_now exists on the stub
          if (!schedulerStub.unstable_now) {
            schedulerStub.unstable_now = function() {
              return window.performance.now();
            };
            console.debug('[Scheduler Fix] Added unstable_now to scheduler stub');
          }
        } else {
          console.error('[Scheduler Fix] ERROR: Scheduler stub not found! Creating now...');
          window.__ASTRO_SCHEDULER_STUB__ = {
            unstable_now: function() {
              return window.performance.now();
            }
          };
          if (!window.scheduler) {
            window.scheduler = window.__ASTRO_SCHEDULER_STUB__;
          }
        }
        
        // Also ensure it's available as a module export stub
        // This helps if React's scheduler tries to import it
        if (typeof module !== 'undefined' && module.exports && !module.exports.scheduler) {
          try {
            module.exports.scheduler = schedulerStub;
            console.debug('[Scheduler Fix] Created module.exports.scheduler');
          } catch (e) {
            // Ignore if module.exports is not writable
          }
        }
        
        // CRITICAL: Intercept Object.defineProperty to handle undefined/null objects
        const definePropertyInterceptTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Setting up Object.defineProperty interceptor at:', definePropertyInterceptTime, 'ms (elapsed:', (definePropertyInterceptTime - startTime).toFixed(2), 'ms)');
        
        const originalDefineProperty = Object.defineProperty;
        let definePropertyCallCount = 0;
        Object.defineProperty = function(obj, prop, descriptor) {
          definePropertyCallCount++;
          const callTime = performance.now ? performance.now() : Date.now();
          
          // If trying to set unstable_now on undefined/null, use the stub instead
          if (prop === 'unstable_now' && (obj === null || obj === undefined)) {
            console.debug('[Scheduler Fix] Call #' + definePropertyCallCount + ': Redirecting unstable_now to stub (Object.defineProperty on undefined) at:', callTime, 'ms (elapsed:', (callTime - startTime).toFixed(2), 'ms)', {
              obj: obj,
              prop: prop,
              hasDescriptor: !!descriptor
            });
            return originalDefineProperty.call(this, schedulerStub, prop, descriptor);
          }
          try {
            return originalDefineProperty.call(this, obj, prop, descriptor);
          } catch (e) {
            // If error is about setting unstable_now on undefined, use stub
            if (e?.message?.includes('Cannot set properties') && 
                e.message.includes('undefined') && 
                prop === 'unstable_now') {
              console.debug('[Scheduler Fix] Call #' + definePropertyCallCount + ': Caught error, redirecting unstable_now to stub at:', callTime, 'ms (elapsed:', (callTime - startTime).toFixed(2), 'ms)', {
                error: e.message,
                obj: obj,
                prop: prop
              });
              return originalDefineProperty.call(this, schedulerStub, prop, descriptor);
            }
            throw e;
          }
        };
        console.debug('[Scheduler Fix] Object.defineProperty interceptor installed');
        
        // Note: Direct property assignment interception removed
        // __defineSetter__ is deprecated and causes syntax errors in modern browsers
        // We rely on Object.defineProperty interception and error handling instead
        
        // CRITICAL: Patch module.exports/require to ensure scheduler gets stub
        // This handles cases where React's scheduler module exports unstable_now
        (function() {
          // Store original require if it exists (for CommonJS)
          if (typeof require !== 'undefined' && typeof require.cache !== 'undefined') {
            const originalRequire = require;
            // We can't easily intercept require, but we can patch modules after they load
          }
          
          // For ES modules, we need to patch the module after it loads
          // This is handled by the patchSchedulerModule function below
        })();
        
        // Patch React's scheduler module if it exists
        // This ensures unstable_now is set on a valid object
        let patchCallCount = 0;
        function patchSchedulerModule() {
          patchCallCount++;
          const patchTime = performance.now ? performance.now() : Date.now();
          console.debug('[Scheduler Fix] patchSchedulerModule() called #' + patchCallCount + ' at:', patchTime, 'ms (elapsed:', (patchTime - startTime).toFixed(2), 'ms)');
          
          let patched = false;
          
          // Try to find and patch React's scheduler
          // Check if React is loaded and patch its internals
          if (window.React) {
            console.debug('[Scheduler Fix] React is available, version:', window.React.version || 'unknown');
            if (window.React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED) {
              const internals = window.React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED;
              if (internals.Scheduler && typeof internals.Scheduler === 'object') {
                if (!internals.Scheduler.unstable_now) {
                  internals.Scheduler.unstable_now = schedulerStub.unstable_now;
                  patched = true;
                  console.debug('[Scheduler Fix] Patched React.__SECRET_INTERNALS.Scheduler at:', patchTime, 'ms');
                } else {
                  console.debug('[Scheduler Fix] React.__SECRET_INTERNALS.Scheduler.unstable_now already exists');
                }
              } else {
                console.debug('[Scheduler Fix] React.__SECRET_INTERNALS.Scheduler not found or not an object');
              }
            } else {
              console.debug('[Scheduler Fix] React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED not available');
            }
          } else {
            console.debug('[Scheduler Fix] React not yet loaded');
          }
          
          // Also check if scheduler is in window (some bundlers expose it)
          if (window.scheduler && typeof window.scheduler === 'object') {
            if (!window.scheduler.unstable_now) {
              window.scheduler.unstable_now = schedulerStub.unstable_now;
              patched = true;
              console.debug('[Scheduler Fix] Patched window.scheduler at:', patchTime, 'ms');
            } else {
              console.debug('[Scheduler Fix] window.scheduler.unstable_now already exists');
            }
          } else {
            console.debug('[Scheduler Fix] window.scheduler not found or not an object');
          }
          
          // Patch ReactDOM if it exists
          if (window.ReactDOM) {
            console.debug('[Scheduler Fix] ReactDOM is available');
            if (window.ReactDOM.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED) {
              const internals = window.ReactDOM.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED;
              if (internals.Scheduler && typeof internals.Scheduler === 'object') {
                if (!internals.Scheduler.unstable_now) {
                  internals.Scheduler.unstable_now = schedulerStub.unstable_now;
                  patched = true;
                  console.debug('[Scheduler Fix] Patched ReactDOM.__SECRET_INTERNALS.Scheduler at:', patchTime, 'ms');
                } else {
                  console.debug('[Scheduler Fix] ReactDOM.__SECRET_INTERNALS.Scheduler.unstable_now already exists');
                }
              }
            }
          } else {
            console.debug('[Scheduler Fix] ReactDOM not yet loaded');
          }
          
          console.debug('[Scheduler Fix] patchSchedulerModule() completed, patched:', patched, 'at:', patchTime, 'ms');
          return patched;
        }
          
          // CRITICAL: Try to find scheduler in React's internal modules
          // React's scheduler might be in a separate module that we need to patch
          if (window.__REACT_DEVTOOLS_GLOBAL_HOOK__) {
            // React DevTools hook might give us access to internals
            try {
              const hook = window.__REACT_DEVTOOLS_GLOBAL_HOOK__;
              if (hook.renderers && hook.renderers.size > 0) {
                hook.renderers.forEach(function(renderer) {
                  if (renderer.findFiberByHostInstance) {
                    // This is a React renderer, try to patch its scheduler
                    console.debug('[Scheduler Fix] Found React renderer via DevTools hook');
                  }
                });
              }
            } catch (e) {
              // Ignore errors
            }
          }
          
          // Try to patch scheduler module exports by intercepting module loading
          // This is tricky because we need to patch before React uses it
          // We'll rely on the error handler to catch and fix it
          
          return patched;
        }
        
        // Try to patch immediately
        const immediatePatchTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Scheduling immediate patch attempts at:', immediatePatchTime, 'ms');
        patchSchedulerModule();
        
        // Also try after delays to catch late-loading modules
        const delays = [0, 50, 100, 200, 500];
        delays.forEach(function(delay) {
          setTimeout(function() {
            const delayedTime = performance.now ? performance.now() : Date.now();
            console.debug('[Scheduler Fix] Delayed patch attempt after', delay, 'ms at:', delayedTime, 'ms (elapsed:', (delayedTime - startTime).toFixed(2), 'ms)');
            patchSchedulerModule();
          }, delay);
        });
        
        // Monitor for React loading and patch when it becomes available
        // Listen for script load events (handle both cases: before and after DOMContentLoaded)
        const domCheckTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Checking DOM readyState at:', domCheckTime, 'ms, state:', document.readyState);
        
        if (document.readyState === 'loading') {
          console.debug('[Scheduler Fix] DOM still loading, adding DOMContentLoaded listener');
          document.addEventListener('DOMContentLoaded', function() {
            const domReadyTime = performance.now ? performance.now() : Date.now();
            console.debug('[Scheduler Fix] DOMContentLoaded fired at:', domReadyTime, 'ms (elapsed:', (domReadyTime - startTime).toFixed(2), 'ms)');
            patchSchedulerModule();
          });
        } else {
          // DOM already loaded, patch immediately
          console.debug('[Scheduler Fix] DOM already loaded, patching immediately');
          patchSchedulerModule();
        }
        
        // Also monitor script tags being added
        if (typeof MutationObserver !== 'undefined') {
          const observerSetupTime = performance.now ? performance.now() : Date.now();
          console.debug('[Scheduler Fix] Setting up MutationObserver at:', observerSetupTime, 'ms');
          
          const observer = new MutationObserver(function(mutations) {
            const mutationTime = performance.now ? performance.now() : Date.now();
            mutations.forEach(function(mutation) {
              mutation.addedNodes.forEach(function(node) {
                if (node.nodeName === 'SCRIPT' && (node.src || node.textContent)) {
                  console.debug('[Scheduler Fix] Script tag detected at:', mutationTime, 'ms (elapsed:', (mutationTime - startTime).toFixed(2), 'ms)', {
                    src: node.src || 'inline',
                    hasReact: !!window.React
                  });
                  // Script added, try patching after a short delay
                  setTimeout(function() {
                    const delayedPatchTime = performance.now ? performance.now() : Date.now();
                    console.debug('[Scheduler Fix] Patching after script detection at:', delayedPatchTime, 'ms');
                    patchSchedulerModule();
                  }, 10);
                }
              });
            });
            
            // Also check if React is now available
            if (window.React || window.ReactDOM) {
              console.debug('[Scheduler Fix] React detected in MutationObserver at:', mutationTime, 'ms');
              patchSchedulerModule();
            }
          });
          
          // Observe the document for script additions
          observer.observe(document.documentElement, {
            childList: true,
            subtree: true
          });
          
          // Stop observing after 10 seconds to avoid performance issues
          setTimeout(function() {
            const disconnectTime = performance.now ? performance.now() : Date.now();
            console.debug('[Scheduler Fix] Disconnecting MutationObserver at:', disconnectTime, 'ms (elapsed:', (disconnectTime - startTime).toFixed(2), 'ms)');
            observer.disconnect();
          }, 10000);
        } else {
          console.debug('[Scheduler Fix] MutationObserver not available');
        }
        
        // Also patch on astro:page-load (ViewTransitions)
        document.addEventListener('astro:page-load', function() {
          const pageLoadTime = performance.now ? performance.now() : Date.now();
          console.debug('[Scheduler Fix] astro:page-load event fired at:', pageLoadTime, 'ms (elapsed:', (pageLoadTime - startTime).toFixed(2), 'ms)');
          setTimeout(function() {
            const delayedPatchTime = performance.now ? performance.now() : Date.now();
            console.debug('[Scheduler Fix] Patching after astro:page-load at:', delayedPatchTime, 'ms');
            patchSchedulerModule();
          }, 10);
        });
        
        // Global error handler - Catch and handle scheduler errors gracefully
        const errorHandlerSetupTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Setting up error handler at:', errorHandlerSetupTime, 'ms');
        
        const originalOnError = window.onerror;
        let errorCount = 0;
        window.onerror = function(msg, url, line, col, error) {
          errorCount++;
          const errorTime = performance.now ? performance.now() : Date.now();
          
          if (msg && typeof msg === 'string') {
            // Check if this is the unstable_now error
            if (msg.includes('Cannot set properties of undefined') && 
                msg.includes('unstable_now')) {
              console.debug('[Scheduler Fix] Error #' + errorCount + ': Caught unstable_now error at:', errorTime, 'ms (elapsed:', (errorTime - startTime).toFixed(2), 'ms)', {
                msg: msg,
                url: url,
                line: line,
                col: col,
                error: error
              });
              
              // Try to patch the scheduler again in case it just loaded
              const patched = patchSchedulerModule();
              
              // Also try to ensure scheduler stub is globally available
              // Make it available on window for React to find
              if (!window.scheduler) {
                window.scheduler = schedulerStub;
                console.debug('[Scheduler Fix] Created window.scheduler from stub in error handler');
              }
              
              // Try to patch React's scheduler if React is available
              if (window.React) {
                try {
                  // Try to access React's scheduler through various paths
                  const reactVersion = window.React.version;
                  console.debug('[Scheduler Fix] React version in error handler:', reactVersion);
                  
                  // For React 18+, scheduler is in a separate module
                  // We need to ensure it has access to our stub
                  if (window.React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED) {
                    const internals = window.React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED;
                    if (!internals.Scheduler) {
                      internals.Scheduler = schedulerStub;
                      console.debug('[Scheduler Fix] Created React.__SECRET_INTERNALS.Scheduler in error handler');
                    }
                  }
                } catch (e) {
                  console.debug('[Scheduler Fix] Error patching React internals in error handler:', e);
                }
              } else {
                console.debug('[Scheduler Fix] React not available when error occurred');
              }
              
              // This is a known React/ViewTransitions compatibility issue
              // Log it for debugging - can be removed later if fix works
              console.debug('[Suppressed] React/ViewTransitions compatibility error:', msg, {
                errorNumber: errorCount,
                errorTime: errorTime,
                elapsed: (errorTime - startTime).toFixed(2) + 'ms',
                patched: patched,
                schedulerStubExists: !!window.__ASTRO_SCHEDULER_STUB__,
                windowSchedulerExists: !!window.scheduler,
                reactLoaded: !!window.React
              });
              return true; // Suppress this specific error
            } else {
              console.debug('[Scheduler Fix] Non-scheduler error #' + errorCount + ' at:', errorTime, 'ms:', msg);
            }
          }
          if (originalOnError) {
            return originalOnError.call(this, msg, url, line, col, error);
          }
          return false;
        };
        console.debug('[Scheduler Fix] Error handler installed');
        
        // Catch unhandled promise rejections
        const rejectionHandlerSetupTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Setting up unhandled rejection handler at:', rejectionHandlerSetupTime, 'ms');
        
        let rejectionCount = 0;
        const originalUnhandledRejection = window.onunhandledrejection;
        window.onunhandledrejection = function(event) {
          rejectionCount++;
          const rejectionTime = performance.now ? performance.now() : Date.now();
          const reason = event.reason;
          
          if (reason?.message && typeof reason.message === 'string') {
            if (reason.message.includes('Cannot set properties of undefined') &&
                reason.message.includes('unstable_now')) {
              // Known compatibility issue - log for debugging
              console.debug('[Suppressed] React/ViewTransitions promise rejection #' + rejectionCount + ' at:', rejectionTime, 'ms (elapsed:', (rejectionTime - startTime).toFixed(2), 'ms):', reason.message, {
                reason: reason,
                stack: reason.stack
              });
              event.preventDefault();
              return;
            } else {
              console.debug('[Scheduler Fix] Non-scheduler promise rejection #' + rejectionCount + ' at:', rejectionTime, 'ms:', reason.message);
            }
          } else {
            console.debug('[Scheduler Fix] Promise rejection #' + rejectionCount + ' at:', rejectionTime, 'ms (no message):', reason);
          }
          
          if (originalUnhandledRejection) {
            return originalUnhandledRejection.call(this, event);
          }
        };
        console.debug('[Scheduler Fix] Unhandled rejection handler installed');
        
        const scriptEndTime = performance.now ? performance.now() : Date.now();
        console.debug('[Scheduler Fix] Script initialization completed at:', scriptEndTime, 'ms (total elapsed:', (scriptEndTime - startTime).toFixed(2), 'ms)');
      })();
      
      // Prevent theme flash by setting theme before page renders
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
      })();
    </script>
    <style is:inline>
      /* Critical CSS to prevent nav flash - must match Tailwind classes exactly */
      html.dark nav {
        background-color: rgb(31 41 55 / 0.9);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      html.dark nav.shadow-sm {
        background-color: rgb(31 41 55);
      }
    </style>
    {/* Google Fonts - Load with optimized strategy */}
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {/* 
      ARCHITECTURE: Progressive Enhancement
      
      Loading Strategy:
      1. HTML loads (server-rendered) ✅
         - Links work immediately (full page reloads)
         - User sees content instantly
      
      2. ClientRouter loads immediately (small ~7KB gzipped) ✅
         - Enables smooth page transitions
         - If user clicks before it loads: full page reload (still works!)
         - After it loads: smooth transitions
      
      3. React loads lazily (client:idle, ~44KB gzipped) ✅
         - Loads when browser is idle (~100-500ms)
         - Adds interactivity (dropdowns, mobile menu)
         - By this time, ClientRouter is already initialized
      
      Why ClientRouter loads immediately:
      - Very small bundle (~7KB)
      - Better UX: smooth transitions available sooner
      - If it's not loaded yet, links still work (full page reload)
      
      Why React loads lazily:
      - Large bundle (~44KB)
      - Non-critical for initial render
      - Progressive enhancement: page works without it
    */}
    {/* ClientRouter: Small bundle, loads immediately for better UX */}
    <ClientRouter />
    <title>{pageTitle}</title>
    {/* Canonical URL */}
    <link
      rel="canonical"
      href={url || `${SITE_CONFIG.url}${Astro.url.pathname}`}
    />
    {/* SEO Meta Tags */}
    <SEO
      title={pageTitle}
      description={pageDescription}
      image={image}
      url={url}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
      nofollow={nofollow}
    />
    {/* Schema.org JSON-LD Structured Data */}
    {(schema || schemas) && <Schema schema={schema} schemas={schemas} />}
  </head>
  <body class="bg-white dark:bg-gray-900">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary-500 focus:text-white focus:rounded focus:shadow-lg"
    >
      Skip to main content
    </a>
    {/* 
      React: Large bundle, loads lazily (client:idle)
      - Loads when browser is idle (~100-500ms after page load)
      - ClientRouter is already initialized by this point
      - Navigation works via ViewTransitions (or full page reload if not loaded yet)
      - React adds interactivity (dropdowns, mobile menu) when ready
      
      User Experience:
      - First ~100-500ms: Links work (full page reload if ClientRouter not ready)
      - After ClientRouter loads: Smooth transitions
      - After React loads: Interactive features (dropdowns, mobile menu)
    */}
    <Header client:idle />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SnowParticles />
    {/* Flowbite - Deferred for better performance (non-critical, loads after page interactive) */}
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
    {/* Theme persistence and Flowbite reinit - Non-blocking execution */}
    <script
      is:inline
      define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}
    >
      // Ensure theme persists during ViewTransitions and prevent nav flash
      function applyTheme() {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
      }

      // Re-initialize Flowbite components after ViewTransitions
      // Uses requestIdleCallback for non-blocking execution
      function reinitFlowbite() {
        function initFlowbiteComponents() {
          // Check if Flowbite is loaded
          if (typeof window.initFlowbite === "function") {
            try {
              window.initFlowbite();
            } catch (e) {
              // Ignore errors
            }
          } else if (
            window.FlowbiteInstances &&
            typeof window.FlowbiteInstances.init === "function"
          ) {
            try {
              window.FlowbiteInstances.init();
            } catch (e) {
              // Ignore errors
            }
          } else {
            // Flowbite not loaded yet, wait and retry
            setTimeout(initFlowbiteComponents, 100);
          }
        }

        // Use requestIdleCallback for non-blocking execution
        if (typeof window.requestIdleCallback === "function") {
          window.requestIdleCallback(initFlowbiteComponents, { timeout: 2000 });
        } else {
          // Fallback for browsers without requestIdleCallback
          setTimeout(initFlowbiteComponents, 100);
        }
      }

      // Set theme before swap happens
      document.addEventListener("astro:before-swap", () => {
        applyTheme();
      });

      // Verify ViewTransitions initialized correctly
      document.addEventListener("DOMContentLoaded", function() {
        const hasViewTransitions = typeof document.startViewTransition !== 'undefined';
        // Check for ClientRouter - it might expose different APIs in different Astro versions
        const hasClientRouter = typeof window !== 'undefined' && (
          'navigate' in window ||
          '__ASTRO_ROUTER__' in window ||
          document.querySelector('script[data-astro-router]') !== null
        );
        console.debug('[ViewTransitions] Initialization check:', {
          hasViewTransitions,
          hasClientRouter,
          schedulerStub: !!window.__ASTRO_SCHEDULER_STUB__,
          windowScheduler: !!window.scheduler,
          reactLoaded: typeof window.React !== 'undefined'
        });
        
        if (!hasViewTransitions && !hasClientRouter) {
          console.warn('[ViewTransitions] ViewTransitions not initialized - navigation will use full page reloads');
        }
      });

      // Apply on page load (ViewTransitions) - Non-blocking
      document.addEventListener("astro:page-load", () => {
        console.debug("[ViewTransitions] Page loaded via ViewTransitions");
        applyTheme();
        // Use requestIdleCallback for non-critical operations
        function handlePageLoad() {
          reinitFlowbite();
          // Track page view for Google Analytics (non-blocking)
          if (
            typeof gtag !== "undefined" &&
            gaId &&
            gaId !== "G-XXXXXXXXXX"
          ) {
            gtag("config", gaId, {
              page_path: window.location.pathname,
            });
          }
        }
        // Execute when browser is idle
        if (window.requestIdleCallback) {
          window.requestIdleCallback(handlePageLoad, { timeout: 2000 });
        } else {
          setTimeout(handlePageLoad, 100);
        }
      });
    </script>

    {/* Intelligent link prefetching - Intersection Observer for all internal links */}
    <script is:inline>
      (function () {
        // Track prefetched URLs to avoid duplicates
        const prefetchedUrls = new Set();

        function prefetchLink(url) {
          // Only prefetch internal links
          if (!url || url.startsWith("http") || url.startsWith("//") || url.startsWith("#") || url.startsWith("mailto:") || url.startsWith("tel:")) {
            return;
          }

          // Normalize URL (remove hash, trailing slash)
          const normalizedUrl = url.split("#")[0].replace(/\/$/, "") || "/";
          
          if (prefetchedUrls.has(normalizedUrl)) {
            return;
          }

          // Create prefetch link
          const link = document.createElement("link");
          link.rel = "prefetch";
          link.href = normalizedUrl;
          link.as = "document";
          document.head.appendChild(link);
          prefetchedUrls.add(normalizedUrl);
        }

        function initLinkPrefetching() {
          if (!("IntersectionObserver" in window)) {
            return; // Not supported, fallback to hover only
          }

          // Get all internal links
          const allLinks = document.querySelectorAll('a[href^="/"], a[href^="./"], a[href^="../"]');
          
          if (allLinks.length === 0) {
            return;
          }

          // Create Intersection Observer to prefetch links when they come into view
          const observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  const link = entry.target;
                  if (link.href) {
                    prefetchLink(link.href);
                  }
                  // Unobserve after prefetching to avoid repeated work
                  observer.unobserve(link);
                }
              });
            },
            {
              // Start prefetching 200px before link is visible
              rootMargin: "200px",
              // Only trigger when any part of the link is visible
              threshold: 0.01,
            }
          );

          // Observe all internal links
          allLinks.forEach(function (link) {
            observer.observe(link);

            // Also prefetch on hover for instant navigation (desktop enhancement)
            // This works on desktop and provides instant navigation
            link.addEventListener("mouseenter", function () {
              if (link.href) {
                prefetchLink(link.href);
              }
            }, { once: true }); // Only add listener once
          });
        }

        // Initialize on DOM ready
        function init() {
          initLinkPrefetching();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }

        // Re-initialize after ViewTransitions (new links may be added)
        document.addEventListener("astro:page-load", function () {
          // Small delay to ensure DOM is ready
          setTimeout(init, 100);
        });
      })();
    </script>
  </body>
</html>
