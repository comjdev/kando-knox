---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header";
import "../styles/global.css";
import { SITE_CONFIG } from "../config";
import Footer from "../components/Footer.astro";
import SnowParticles from "../components/shared/SnowParticles.astro";
import Schema from "../components/shared/Schema.astro";
import SEO from "../components/shared/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  nofollow?: boolean;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
}

const {
  title,
  description,
  image,
  url,
  type,
  publishedTime,
  modifiedTime,
  author,
  noindex,
  nofollow,
  schema,
  schemas,
} = Astro.props;
// If title is provided, use it directly (it should already include the suffix)
// Otherwise, use the site title with suffix
const pageTitle = title || `${SITE_CONFIG.title} | Karate | BJJ`;
const pageDescription = description || SITE_CONFIG.description;

// Check if current date is between December 15 and 27
const now = new Date();
const month = now.getMonth(); // 0-11, where 11 is December
const day = now.getDate();
const isDecember15to27 = month === 11 && day >= 15 && day <= 27;
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {/* Google Analytics */}
    {SITE_CONFIG.googleAnalyticsId && SITE_CONFIG.googleAnalyticsId !== "G-XXXXXXXXXX" && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE_CONFIG.googleAnalyticsId}`}
        />
        <script is:inline define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
    <script is:inline>
      // Prevent theme flash by setting theme before page renders
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
      })();
    </script>
    <style is:inline>
      /* Critical CSS to prevent nav flash - must match Tailwind classes exactly */
      html.dark nav {
        background-color: rgb(31 41 55 / 0.9);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      html.dark nav.shadow-sm {
        background-color: rgb(31 41 55);
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{pageTitle}</title>
    {/* SEO Meta Tags */}
    <SEO
      title={pageTitle}
      description={pageDescription}
      image={image}
      url={url}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
      nofollow={nofollow}
    />
    {/* Schema.org JSON-LD Structured Data */}
    {(schema || schemas) && <Schema schema={schema} schemas={schemas} />}
  </head>
  <body class="bg-white dark:bg-gray-900">
    <Header client:load />
    <slot />
    <Footer />
    {isDecember15to27 && <SnowParticles />}
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
    <script
      is:inline
      define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}
    >
      // Ensure theme persists during ViewTransitions and prevent nav flash
      function applyTheme() {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
      }

      // Re-initialize Flowbite components after ViewTransitions
      function reinitFlowbite() {
        // Wait a bit for DOM to be ready
        setTimeout(() => {
          // Try different Flowbite initialization methods
          if (typeof window.initFlowbite === "function") {
            try {
              window.initFlowbite();
            } catch (e) {
              // Ignore errors
            }
          }
          // Also try FlowbiteInstances if available
          if (
            window.FlowbiteInstances &&
            typeof window.FlowbiteInstances.init === "function"
          ) {
            try {
              window.FlowbiteInstances.init();
            } catch (e) {
              // Ignore errors
            }
          }
        }, 100);
      }

      // Set theme before swap happens
      document.addEventListener("astro:before-swap", () => {
        applyTheme();
      });

      // Apply on page load (ViewTransitions)
      document.addEventListener("astro:page-load", () => {
        applyTheme();
        reinitFlowbite();
        // Track page view for Google Analytics
        if (
          typeof gtag !== "undefined" &&
          gaId &&
          gaId !== "G-XXXXXXXXXX"
        ) {
          gtag("config", gaId, {
            page_path: window.location.pathname,
          });
        }
      });
    </script>
  </body>
</html>
