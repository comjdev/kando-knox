---
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header";
import "../styles/global.css";
import { SITE_CONFIG } from "../config";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_CONFIG.title}` : SITE_CONFIG.title;
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions fallback="animate" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-white dark:bg-gray-900">
    <Header client:visible />
    <slot />
    <Footer />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
  </body>
</html>
