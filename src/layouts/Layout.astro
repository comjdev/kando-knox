---
import Header from "../components/Header";
import "../styles/global.css";
import { SITE_CONFIG } from "../config";
import Footer from "../components/Footer.astro";
import SnowParticles from "../components/shared/SnowParticles.astro";
import Schema from "../components/shared/Schema.astro";
import SEO from "../components/shared/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  nofollow?: boolean;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
}

const {
  title,
  description,
  image,
  url,
  type,
  publishedTime,
  modifiedTime,
  author,
  noindex,
  nofollow,
  schema,
  schemas,
} = Astro.props;
// If title is provided, use it directly (it should already include the suffix)
// Otherwise, use the site title with suffix
import { generatePageTitle } from "../utils/titles";
const pageTitle = title || generatePageTitle(SITE_CONFIG.title, ["Karate", "BJJ"]);
const pageDescription = description || SITE_CONFIG.description;

// Snow effect is now handled client-side in SnowParticles component
---

<!doctype html>
<html lang="en-AU" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    {/* Critical CSS - Inline to prevent layout shifts */}
    <style is:inline>
      /* Critical above-the-fold styles to prevent CLS */
      body {
        margin: 0;
        font-family: "Teachers", sans-serif;
        background-color: #ffffff;
        color: #111827;
      }
      html.dark body {
        background-color: #111827;
        color: #f9fafb;
      }
      /* Prevent layout shift for hero carousel */
      .hero-carousel-wrapper {
        background-color: #111111;
      }
      /* Prevent layout shift for navigation */
      nav {
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      html.dark nav {
        background-color: rgba(31, 41, 55, 0.9);
      }
      /* Prevent layout shift for buttons */
      .hero-button {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background-color: #c39519;
        color: #ffffff;
        border-radius: 0.25rem;
        text-decoration: none;
        font-weight: 500;
        margin-top: 1.25rem;
      }
      .hero-button.hidden {
        display: none;
      }
      /* Ensure buttons on active slides don't cause shifts */
      .list .item:nth-child(1) .content .hero-button,
      .list .item:nth-child(2) .content .hero-button {
        display: inline-block;
      }
      /* Prevent layout shift for program cards */
      .bg-white {
        background-color: #ffffff;
      }
      html.dark .bg-white,
      html.dark .dark\:bg-gray-900 {
        background-color: #111827;
      }
      html.dark .dark\:bg-gray-800 {
        background-color: #1f2937;
      }
      /* Prevent layout shift for text colors */
      .text-gray-900 {
        color: #111827;
      }
      html.dark .dark\:text-white {
        color: #f9fafb;
      }
      .text-gray-500 {
        color: #6b7280;
      }
      html.dark .dark\:text-gray-400 {
        color: #9ca3af;
      }
    </style>
    
    {/* Resource Hints for Performance - Critical for faster loading */}
    {/* Preconnect to Google Fonts (early connection for faster font loading) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    {/* Preconnect to Google Analytics (early connection) */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    {/* Google Analytics - Deferred for better performance */}
    {SITE_CONFIG.googleAnalyticsId && SITE_CONFIG.googleAnalyticsId !== "G-XXXXXXXXXX" && (
      <>
        <script
          defer
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE_CONFIG.googleAnalyticsId}`}
        />
        {/* Inline GA config - loads after gtag.js via defer */}
        <script
          is:inline
          define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}
        >
          // Initialize GA after gtag.js loads (deferred)
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          // Wait for DOM and gtag.js to be ready
          function initGA() {
            if (window.gtag) {
              gtag("js", new Date());
              gtag("config", gaId);
            } else {
              // gtag.js not loaded yet, wait a bit
              setTimeout(initGA, 50);
            }
          }
          // Start initialization when DOM is ready (non-blocking)
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initGA);
          } else {
            // Use requestIdleCallback for non-blocking execution
            if (window.requestIdleCallback) {
              window.requestIdleCallback(initGA, { timeout: 1000 });
            } else {
              setTimeout(initGA, 100);
            }
          }
        </script>
      </>
    )}
    <script is:inline>
      // Prevent theme flash by setting theme before page renders
      (function () {
        if (typeof window === 'undefined') return;
        
        try {
          const savedTheme = localStorage.getItem("theme");
          const systemPrefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
          document.documentElement.classList.remove("light", "dark");
          document.documentElement.classList.add(theme);
          
          // Ensure theme is saved to localStorage if it wasn't already
          if (!savedTheme) {
            localStorage.setItem("theme", theme);
          }
        } catch (e) {
          // If localStorage is not available (e.g., private browsing), fallback to system preference
          const systemPrefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          const theme = systemPrefersDark ? "dark" : "light";
          document.documentElement.classList.remove("light", "dark");
          document.documentElement.classList.add(theme);
        }
      })();
    </script>
    <style is:inline>
      /* Critical CSS to prevent nav flash - must match Tailwind classes exactly */
      html.dark nav {
        background-color: rgb(31 41 55 / 0.9);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      html.dark nav.shadow-sm {
        background-color: rgb(31 41 55);
      }
    </style>
    {/* Google Fonts - Load with optimized strategy */}
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Teachers:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{pageTitle}</title>
    {/* Canonical URL */}
    <link
      rel="canonical"
      href={url || `${SITE_CONFIG.url}${Astro.url.pathname}`}
    />
    {/* SEO Meta Tags */}
    <SEO
      title={pageTitle}
      description={pageDescription}
      image={image}
      url={url}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
      nofollow={nofollow}
    />
    {/* Schema.org JSON-LD Structured Data */}
    {(schema || schemas) && <Schema schema={schema} schemas={schemas} />}
  </head>
  <body class="bg-white dark:bg-gray-900">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary-500 focus:text-white focus:rounded focus:shadow-lg"
    >
      Skip to main content
    </a>
    {/* 
      React: Large bundle, loads lazily (client:idle)
      - Loads when browser is idle (~100-500ms after page load)
      - React adds interactivity (dropdowns, mobile menu) when ready
    */}
    <Header client:idle />
    <main id="main-content">
      <slot />
    </main>
    <!-- Noscript fallback: Ensure content is visible without JavaScript for SEO -->
    <noscript>
      <style>
        main#main-content section,
        main#main-content header,
        main#main-content img {
          opacity: 1 !important;
          filter: none !important;
          transform: none !important;
          visibility: visible !important;
        }
      </style>
    </noscript>
    <Footer />
    <SnowParticles />
    <!-- Prevent flash of images before GSAP animations - runs immediately -->
    <script is:inline>
      (function() {
        // Respect user's motion preferences - skip hiding if reduced motion is preferred
        const prefersReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReducedMotion) {
          return; // Don't hide content if user prefers reduced motion
        }

        // Hide first section images immediately to prevent flash
        function hideFirstSectionImages() {
          const mainContent = document.querySelector("main#main-content");
          if (mainContent) {
            // Hide header elements with background images (location pages)
            const headerElements = mainContent.querySelectorAll("header[style*='background-image']");
            headerElements.forEach(header => {
              if (!header.closest(".hero-carousel-wrapper")) {
                header.style.opacity = "0";
                header.style.filter = "blur(10px)";
              }
            });

            const sections = Array.from(mainContent.querySelectorAll("section"));
            const firstNonHeroSection = sections.find(section => 
              !section.querySelector(".hero-carousel-wrapper")
            );
            if (firstNonHeroSection) {
              const images = firstNonHeroSection.querySelectorAll("img:not(.hero-carousel-wrapper img)");
              images.forEach(img => {
                // Skip bear cave logo
                if (img.alt && img.alt.toLowerCase().includes("bear cave")) return;
                if (img.src && img.src.toLowerCase().includes("bear-cave")) return;
                
                // Check if this is a team photo
                const section = img.closest("section");
                const isTeamPhoto = section && (
                  section.querySelector("h2")?.textContent?.toLowerCase().includes("people make us great") ||
                  section.querySelector("h2")?.textContent?.toLowerCase().includes("our team")
                );
                
                if (isTeamPhoto) {
                  // Team photos use scale animation, not blur
                  img.style.opacity = "0";
                  img.style.transform = "scale(0.95)";
                } else {
                  // Other images use blur
                  img.style.opacity = "0";
                  img.style.filter = "blur(10px)";
                }
              });
            }
          }
        }
        
        // Run immediately if DOM is ready, otherwise wait
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hideFirstSectionImages);
        } else {
          hideFirstSectionImages();
        }
        
        // Also run on next tick to catch any late-loading images
        setTimeout(hideFirstSectionImages, 0);
      })();
    </script>
    {/* Flowbite - Deferred for better performance (non-critical, loads after page interactive) */}
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
    {/* Theme persistence and Flowbite reinit - Non-blocking execution */}
    <script
      is:inline
      define:vars={{ gaId: SITE_CONFIG.googleAnalyticsId }}
    >
      // Re-initialize Flowbite components on page load
      // Uses requestIdleCallback for non-blocking execution
      function reinitFlowbite() {
        function initFlowbiteComponents() {
          // Check if Flowbite is loaded
          if (typeof window.initFlowbite === "function") {
            try {
              window.initFlowbite();
            } catch (e) {
              // Ignore errors
            }
          } else if (
            window.FlowbiteInstances &&
            typeof window.FlowbiteInstances.init === "function"
          ) {
            try {
              window.FlowbiteInstances.init();
            } catch (e) {
              // Ignore errors
            }
          } else {
            // Flowbite not loaded yet, wait and retry
            setTimeout(initFlowbiteComponents, 100);
          }
        }

        // Use requestIdleCallback for non-blocking execution
        if (typeof window.requestIdleCallback === "function") {
          window.requestIdleCallback(initFlowbiteComponents, { timeout: 2000 });
        } else {
          // Fallback for browsers without requestIdleCallback
          setTimeout(initFlowbiteComponents, 100);
        }
      }

      // Initialize on page load
      document.addEventListener("DOMContentLoaded", function() {
        reinitFlowbite();
        // Track page view for Google Analytics (non-blocking)
        if (
          typeof gtag !== "undefined" &&
          gaId &&
          gaId !== "G-XXXXXXXXXX"
        ) {
          gtag("config", gaId, {
            page_path: window.location.pathname,
          });
        }
      });
    </script>

    {/* Intelligent link prefetching - Intersection Observer for all internal links */}
    <script is:inline>
      (function () {
        // Track prefetched URLs to avoid duplicates
        const prefetchedUrls = new Set();

        function prefetchLink(url) {
          // Only prefetch internal links
          if (!url || url.startsWith("http") || url.startsWith("//") || url.startsWith("#") || url.startsWith("mailto:") || url.startsWith("tel:")) {
            return;
          }

          // Normalize URL (remove hash, trailing slash)
          const normalizedUrl = url.split("#")[0].replace(/\/$/, "") || "/";
          
          if (prefetchedUrls.has(normalizedUrl)) {
            return;
          }

          // Create prefetch link
          const link = document.createElement("link");
          link.rel = "prefetch";
          link.href = normalizedUrl;
          link.as = "document";
          document.head.appendChild(link);
          prefetchedUrls.add(normalizedUrl);
        }

        function initLinkPrefetching() {
          if (!("IntersectionObserver" in window)) {
            return; // Not supported, fallback to hover only
          }

          // Get all internal links
          const allLinks = document.querySelectorAll('a[href^="/"], a[href^="./"], a[href^="../"]');
          
          if (allLinks.length === 0) {
            return;
          }

          // Create Intersection Observer to prefetch links when they come into view
          const observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  const link = entry.target;
                  if (link.href) {
                    prefetchLink(link.href);
                  }
                  // Unobserve after prefetching to avoid repeated work
                  observer.unobserve(link);
                }
              });
            },
            {
              // Start prefetching 200px before link is visible
              rootMargin: "200px",
              // Only trigger when any part of the link is visible
              threshold: 0.01,
            }
          );

          // Observe all internal links
          allLinks.forEach(function (link) {
            observer.observe(link);

            // Also prefetch on hover for instant navigation (desktop enhancement)
            // This works on desktop and provides instant navigation
            link.addEventListener("mouseenter", function () {
              if (link.href) {
                prefetchLink(link.href);
              }
            }, { once: true }); // Only add listener once
          });
        }

        // Initialize on DOM ready
        function init() {
          initLinkPrefetching();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
    <script>
      import "../scripts/form-handler";
    </script>
  </body>
</html>
