---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONFIG } from "../../config";
import ProgramHeader from "../../components/program/ProgramHeader.astro";
import ProgramIntro from "../../components/program/ProgramIntro.astro";
import ProgramContent from "../../components/program/ProgramContent.astro";
import ProgramFAQs from "../../components/program/ProgramFAQs.astro";
import BookTrial from "../../components/shared/BookTrial.astro";
import ProgramTimetable from "../../components/shared/Timetable.astro";
import {
  getProgramServiceSchema,
  getProgramFAQPageSchema,
} from "../../utils/schema";
import { getProgramPageTitle } from "../../utils/titles";
import { formatMetaDescription } from "../../utils/descriptions";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const programs = await getCollection("programs");

  return programs.map((program) => ({
    params: { slug: program.data.slug },
    props: { program: program.data },
  }));
}

const { program } = Astro.props;

// Generate page title - use titleTag if provided, otherwise generate from program title
const pageTitle = program.titleTag
  ? program.titleTag
  : getProgramPageTitle(program.title);

// Generate schemas for this program page
// Service name format: "{Program Title} Classes in Knox"
const serviceName = `${program.title} Classes in Knox`;
// Service type: Use the program title as service type (e.g., "Pre-School Martial Arts and Karate")
const serviceType = program.title;
const serviceSchema = getProgramServiceSchema(
  serviceName,
  serviceType,
  program.slug
);
const faqSchema = getProgramFAQPageSchema();
const schemas = [serviceSchema, faqSchema];

// Format meta description - prioritize metaDescription field, then description, then shortDescription
const metaDesc = formatMetaDescription(
  program.metaDescription || program.description || program.shortDescription,
  undefined,
  [program.title, "Knox", "Boronia", "martial arts"]
);
---

<Layout
  title={pageTitle}
  description={metaDesc}
  image={program.image}
  type="website"
  url={`${SITE_CONFIG.url}/programs/${program.slug}`}
  schemas={schemas}
>
  <ProgramHeader
    title={program.title}
    image={program.image}
    description={program.description}
    shortDescription={program.shortDescription}
    ageGroup={program.ageGroup}
  />

  <ProgramIntro
    title={program.title}
    description={program.description}
    shortDescription={program.shortDescription}
    features={program.features}
    schedule={program.schedule}
    bearCave={program.bearCave}
  />

  <ProgramContent content={program.content} />

  <BookTrial trial={program.trial} title={program.title} />

  <ProgramTimetable schedule={program.schedule} title={program.title} />

  <ProgramFAQs faq={program.faq} />
</Layout>
