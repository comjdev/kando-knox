---
import Layout from "../layouts/Layout.astro";
import BlogGrid from "../components/shared/BlogGrid.astro";
import CategoryFilter from "../components/shared/CategoryFilter";
import { getCustomPageTitle } from "../utils/titles";
import { SITE_CONFIG } from "../config";
import { getCustomPageTitle } from "../utils/titles";

// Load all blog posts to extract categories
const blogPosts = import.meta.glob("../content/blog/*.md", { eager: true });
const allPosts = Object.values(blogPosts).map((post: any) => ({
  category: post.frontmatter.category || null,
}));

// Get unique categories (support both string and array)
const categoriesSet = new Set<string>();
allPosts.forEach((post) => {
  if (post.category) {
    if (Array.isArray(post.category)) {
      // Multiple categories
      post.category.forEach((cat: string) => categoriesSet.add(cat));
    } else {
      // Single category
      categoriesSet.add(post.category);
    }
  }
});
const categories = Array.from(categoriesSet).sort();

// Check if there are uncategorized posts
const hasUncategorized = allPosts.some((post) => !post.category);
if (hasUncategorized) {
  categories.push("Uncategorized");
}

const pageTitle = getCustomPageTitle(undefined, "Martial Arts Blog");
const pageDescription =
  "Read our latest articles about martial arts, karate, Brazilian Jiu-Jitsu, self-defence, and more.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/img/default.jpg"
  type="website"
  url={`${SITE_CONFIG.url}/blog`}
>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-7xl lg:py-16 lg:px-6">
      <div class="mx-auto max-w-screen-sm text-center lg:mb-16 mb-8">
        <h2
          class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
        >
          Our Blog
        </h2>
        <p class="font-light text-gray-500 sm:text-xl dark:text-gray-400">
          Read our latest articles about martial arts, karate, Brazilian
          Jiu-Jitsu, self-defence, and more.
        </p>
        {
          categories.length > 0 && (
            <CategoryFilter client:load categories={categories} />
          )
        }
      </div>

      <BlogGrid />
    </div>
  </section>
</Layout>
