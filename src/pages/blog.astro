---
import Layout from "../layouts/Layout.astro";
import Card from "../components/shared/Card.astro";

const blogPosts = import.meta.glob("../content/blog/*.md", { eager: true });
const posts = Object.values(blogPosts).sort((a: any, b: any) => {
  const dateA = new Date(a.frontmatter.date).getTime();
  const dateB = new Date(b.frontmatter.date).getTime();
  return dateB - dateA;
});
---

<Layout>
  <main class="mx-auto max-w-6xl flex flex-col">
    <h1 class="text-4xl font-bold underline">Blog</h1>
    <p class="text-gray-500">Read our latest blog posts</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
      {
        posts.map((post: any) => (
          <Card
            title={post.frontmatter.title}
            slug={post.frontmatter.slug}
            description={post.frontmatter.description}
            date={post.frontmatter.date}
            image={post.frontmatter.image}
          />
        ))
      }
    </div>
  </main>
</Layout>
