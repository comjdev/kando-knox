---
import Layout from "../../layouts/Layout.astro";
import ScrollAnimations from "../../components/home/ScrollAnimations";
import PageTemplate from "../../components/shared/PageTemplate.astro";
import LocationMap from "../../components/shared/LocationMap.astro";
import FAQs from "../../components/shared/FAQs.astro";
import LocationPrograms from "../../components/locations/LocationPrograms.astro";
import LocationBookTrial from "../../components/locations/LocationBookTrial.astro";
import LocationsFAQs from "../../components/locations/LocationsFAQs.astro";
import WhyKando from "../../components/locations/WhyKando.astro";
import Testimonials from "../../components/shared/Testimonials.astro";
import LatestPosts from "../../components/shared/LatestPosts.astro";
import {
  getLocationLocalBusinessSchema,
  getLocationServiceSchema,
  getLocationFAQPageSchema,
  getReviewSchema,
} from "../../utils/schema";
import googleReviews from "../../content/testimonials/google-reviews.json";
import { getLocationPageTitle } from "../../utils/titles";
import { SITE_CONFIG } from "../../config";
import { formatMetaDescription } from "../../utils/descriptions";

import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allLocations = await getCollection("locations");

  // Filter out files that don't have a slug (like FAQ files)
  const locations = allLocations.filter((location) => location.data.slug);

  return locations.map((location) => ({
    params: { location: location.data.slug },
    props: { location: location.data },
  }));
}

const { location } = Astro.props;

// Get featured image or use default
const featuredImage =
  location.image || location.featuredImage || "/img/default.jpg";

// Get transition name for view transitions
const transitionName = location.transitionName || `location-${location.slug}`;

// Load FAQ files - use glob to get both content root and locations subdirectory
const allFaqFiles = Object.entries(
  import.meta.glob("../../content/**/*.json", { eager: true })
).map(([path, file]: [string, any]) => ({
  path,
  data: file.default,
}));

// Extract FAQ data - can be directly on location, a filename string, or in a dedicated section
let faqs: Array<{ question: string; answer: string }> = [];

if (typeof location.faqs === "string") {
  // Load FAQ file if faqs is a filename string (e.g., "faqs-karate.json")
  const faqFile = allFaqFiles.find((f) => {
    const fileName = f.path.split("/").pop() || "";
    return (
      fileName === location.faqs ||
      fileName.includes(location.faqs.replace(".json", ""))
    );
  });

  if (faqFile?.data?.faqs && Array.isArray(faqFile.data.faqs)) {
    faqs = faqFile.data.faqs;

    // Replace LOCATION placeholder with actual location name
    faqs = faqs.map((faq: { question: string; answer: string }) => ({
      question: faq.question.replace(/LOCATION/g, location.locationName),
      answer: faq.answer.replace(/LOCATION/g, location.locationName),
    }));
  }
} else if (Array.isArray(location.faqs)) {
  // Use FAQs array directly if provided
  faqs = location.faqs;
}

// Generate page title - check if location has titleTag, otherwise use default
// Determine if it's BJJ or Karate based on location data or default to Karate
const programType = (location.programType || "Karate") as "Karate" | "BJJ";

// Generate schemas for this location page
// LocalBusiness schema (primary for local SEO) - includes full NAP and geographic data
const localBusinessSchema = getLocationLocalBusinessSchema(
  location.locationName,
  location.slug
);
// Service schema (secondary) - location-specific service (dynamic based on programType)
const serviceSchema = getLocationServiceSchema(
  location.locationName,
  location.slug,
  location.title,
  programType
);
// FAQPage schema - for rich snippets
const faqSchema = getLocationFAQPageSchema(location.locationName);
// Review schema - aggregate rating and reviews from Google
// Filter out reviews without text
const reviewsWithText = googleReviews.filter(
  (review): review is typeof review & { text: string } => !!review.text
);
const googleBusinessUrl =
  SITE_CONFIG.googleBusinessUrl || googleReviews[0]?.url || undefined;
const reviewSchema = getReviewSchema(reviewsWithText, googleBusinessUrl);
// Combine all schemas
const schemas = [localBusinessSchema, serviceSchema, faqSchema, reviewSchema];
const pageTitle = location.titleTag
  ? location.titleTag
  : getLocationPageTitle(location.locationName, programType);

// Format meta description - prioritize metaDescription field, then description
// Use dynamic keywords based on program type
const programKeywords =
  programType === "BJJ"
    ? [
        "bjj classes",
        "brazilian jiu-jitsu",
        location.locationName,
        "Knox",
        "Boronia",
        "martial arts",
      ]
    : [
        "karate classes",
        location.locationName,
        "Knox",
        "Boronia",
        "martial arts",
      ];
const metaDesc = formatMetaDescription(
  location.metaDescription || location.description,
  undefined,
  programKeywords
);
---

<Layout
  title={pageTitle}
  description={metaDesc}
  image={featuredImage}
  type="website"
  url={`${SITE_CONFIG.url}/locations/${location.slug}`}
  schemas={schemas}
>
  <PageTemplate
    title={location.title}
    description={location.description}
    image={featuredImage}
    transitionName={transitionName}
    programType={programType}
    locationName={location.locationName}
  >
    <!-- Intro Section -->
    {
      location.intro && (
        <section class="my-8">
          {location.intro.heading && (
            <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
              {location.intro.heading}
            </h2>
          )}
          {location.intro.description && (
            <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
              {location.intro.description}
            </p>
          )}
        </section>
      )
    }

    <!-- Kando Info Section -->
    {
      location.kandoInfo && (
        <section class="my-8">
          {location.kandoInfo.heading && (
            <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
              {location.kandoInfo.heading}
            </h2>
          )}
          {location.kandoInfo.description &&
            Array.isArray(location.kandoInfo.description) && (
              <div class="space-y-4">
                {location.kandoInfo.description.map((paragraph: string) => (
                  <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                    {paragraph}
                  </p>
                ))}
              </div>
            )}
          {location.kandoInfo.description &&
            typeof location.kandoInfo.description === "string" && (
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                {location.kandoInfo.description}
              </p>
            )}
        </section>
      )
    }

    <!-- Serving Area Section -->
    {
      location.servingArea && (
        <section class="my-8">
          {location.servingArea.heading && (
            <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
              {location.servingArea.heading}
            </h2>
          )}
          {location.servingArea.description && (
            <p
              class="text-gray-700 dark:text-gray-300 leading-relaxed"
              set:html={location.servingArea.description}
            />
          )}
        </section>
      )
    }

    <!-- Get to Kando Section -->
    {
      location.getToKando && (
        <section class="my-8">
          {location.getToKando.heading && (
            <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
              {location.getToKando.heading}
            </h2>
          )}
          {location.getToKando.description &&
            Array.isArray(location.getToKando.description) && (
              <div class="space-y-4">
                {location.getToKando.description.map((paragraph: string) => (
                  <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                    {paragraph}
                  </p>
                ))}
              </div>
            )}
          {location.getToKando.description &&
            typeof location.getToKando.description === "string" && (
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                {location.getToKando.description}
              </p>
            )}
        </section>
      )
    }
  </PageTemplate>

  <!-- Full Screen Map Section -->
  <LocationMap
    mapEmbed={location.mapEmbed}
    locationName={location.locationName}
  />

  <!-- Classes Section -->
  {
    location.classes && (
      <LocationPrograms
        classes={location.classes}
        locationName={location.locationName}
        programType={programType}
      />
    )
  }

  <!-- Testimonials Section -->
  {
    location.testimonials && (
      <Testimonials testimonials={location.testimonials} />
    )
  }

  <!-- Book a Trial Section -->
  {
    location.programs && (
      <LocationBookTrial
        programs={location.programs}
        programType={programType}
      />
    )
  }

  <!-- Why Choose Us Section -->
  {location.whyChooseUs && <WhyKando whyChooseUs={location.whyChooseUs} />}

  <!-- FAQ Section -->
  {
    faqs.length > 0 && (
      <LocationsFAQs
        faq={faqs}
        title={`Frequently asked questions about ${programType === "BJJ" ? "Brazilian Jiu-Jitsu (BJJ)" : "karate"} in ${location.locationName}`}
      />
    )
  }

  <!-- Latest Posts Section -->
  <LatestPosts />

  <ScrollAnimations client:idle />
</Layout>
