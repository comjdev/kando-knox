---
import Layout from "../layouts/Layout.astro";
import PageTemplate from "../components/shared/PageTemplate.astro";
import Program from "../components/shared/Program.astro";
import Team from "../components/home/Team.astro";
import TrialForm from "../components/shared/TrialForm.astro";
import { getCustomPageTitle, getAboutPageTitle } from "../utils/titles";
import { SITE_CONFIG } from "../config";

export async function getStaticPaths() {
  const pages = Object.values(
    import.meta.glob("../content/pages/*.md", { eager: true })
  );

  return pages
    .map((page: any) => ({
      params: { slug: page.frontmatter.slug },
      props: { page },
    }))
    .filter((path) => {
      // Exclude common static file requests that shouldn't be handled by this route
      const excludedPaths = ["favicon.ico", "robots.txt", "sitemap.xml"];
      return !excludedPaths.includes(path.params.slug);
    });
}

const { page } = Astro.props;

// Get featured image or use default
const featuredImage =
  page.frontmatter.image ||
  page.frontmatter.featuredImage ||
  "/img/default.jpg";

// Get transition name for view transitions
const transitionName =
  page.frontmatter.transitionName || `page-${page.frontmatter.slug}`;

// Generate page title
// Special handling for about page
let pageTitle: string;
if (page.frontmatter.slug === "about") {
  pageTitle = page.frontmatter.titleTag || getAboutPageTitle();
} else {
  pageTitle = getCustomPageTitle(
    page.frontmatter.titleTag,
    page.frontmatter.title
  );
}
---

<Layout
  title={pageTitle}
  description={page.frontmatter.description}
  image={featuredImage}
  type="website"
  url={`${SITE_CONFIG.url}/${page.frontmatter.slug}`}
>
  <PageTemplate
    title={page.frontmatter.title}
    description={page.frontmatter.description}
    image={featuredImage}
    transitionName={transitionName}
  >
    <page.Content />
  </PageTemplate>

  <TrialForm />

  <Team />

  <Program />
</Layout>
