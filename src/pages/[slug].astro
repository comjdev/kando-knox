---
import Layout from "../layouts/Layout.astro";
import PageTemplate from "../components/shared/PageTemplate.astro";

export async function getStaticPaths() {
  const pages = Object.values(
    import.meta.glob("../content/pages/*.md", { eager: true })
  );

  return pages.map((page: any) => ({
    params: { slug: page.frontmatter.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// Get featured image or use default
const featuredImage =
  page.frontmatter.image ||
  page.frontmatter.featuredImage ||
  "/img/default.jpg";

// Get transition name for view transitions
const transitionName =
  page.frontmatter.transitionName || `page-${page.frontmatter.slug}`;
---

<Layout>
  <PageTemplate
    title={page.frontmatter.title}
    description={page.frontmatter.description}
    image={featuredImage}
    transitionName={transitionName}
  >
    <page.Content />
  </PageTemplate>
</Layout>
