---
import Layout from "../layouts/Layout.astro";
import LocationMap from "../components/shared/LocationMap.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { SITE_CONFIG } from "../config";
import { getCustomPageTitle } from "../utils/titles";
import { formatMetaDescription } from "../utils/descriptions";
import { getImageAsset } from "../utils/imageMap";

const formattedAddress = `${SITE_CONFIG.address.street}, ${SITE_CONFIG.address.city} ${SITE_CONFIG.address.state} ${SITE_CONFIG.address.postcode}, ${SITE_CONFIG.address.country}`;
const pageTitle = getCustomPageTitle(undefined, "Contact Us");
const pageDescription = formatMetaDescription(
  `Contact ${SITE_CONFIG.title} in ${SITE_CONFIG.address.city} for karate and Brazilian Jiu-Jitsu classes. Call ${SITE_CONFIG.phone} or email ${SITE_CONFIG.email} to book a trial class.`,
  undefined,
  ["martial arts", "Knox", "Boronia"]
);

// Get the contact image asset
const contactImageAsset = getImageAsset("/img/kando-contact.jpg");
const contactImageUrl =
  typeof contactImageAsset === "object"
    ? contactImageAsset.src
    : "/img/kando-contact.jpg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={contactImageUrl}
  type="website"
  url={`${SITE_CONFIG.url}/contact`}
>
  <section class="bg-white dark:bg-gray-900">
    <div
      class="bg-no-repeat bg-cover bg-center bg-gray-700 bg-blend-multiply"
      style={`background-image: url('${contactImageUrl}');`}
    >
      <div
        class="px-4 lg:pt-24 pt-8 pb-72 lg:pb-80 mx-auto max-w-screen-sm text-center lg:px-6"
      >
        <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-white">
          Contact Us
        </h2>
        <p class="mb-16 font-light text-gray-400 sm:text-xl">
          Contact us for more information about our martial arts programs and
          services. We are always happy to help.
        </p>
      </div>
    </div>
    <div class="py-16 px-4 mx-auto -mt-96 max-w-7xl sm:py-24 lg:px-6">
      <ContactForm />
      <div
        class="space-y-8 text-center md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
      >
        <div>
          <div
            class="flex justify-center items-center mx-auto mb-4 w-10 h-10 bg-gray-100 rounded-lg dark:bg-gray-800 lg:h-16 lg:w-16"
          >
            <svg
              class="w-5 h-5 text-gray-600 lg:w-8 lg:h-8 dark:text-gray-500"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              ></path><path
                d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
              ></path></svg
            >
          </div>
          <p class="mb-2 text-xl font-bold dark:text-white">Email us:</p>
          <p class="mb-3 text-gray-500 dark:text-gray-400">
            Email us for general queries, including booking and scheduling.
          </p>
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="font-semibold text-primary-500 hover:underline"
            >{SITE_CONFIG.email}</a
          >
        </div>
        <div>
          <div
            class="flex justify-center items-center mx-auto mb-4 w-10 h-10 bg-gray-100 rounded-lg dark:bg-gray-800 lg:h-16 lg:w-16"
          >
            <svg
              class="w-5 h-5 text-gray-600 lg:w-8 lg:h-8 dark:text-gray-500"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
              ></path></svg
            >
          </div>
          <p class="mb-2 text-xl font-bold dark:text-white">Call us:</p>
          <p class="mb-3 text-gray-500 dark:text-gray-400">
            Call us to speak to a member of our team. We are always happy to
            help.
          </p>
          <span class="font-semibold text-primary-500">{SITE_CONFIG.phone}</span
          >
        </div>
        <div>
          <div
            class="flex justify-center items-center mx-auto mb-4 w-10 h-10 bg-gray-100 rounded-lg dark:bg-gray-800 lg:h-16 lg:w-16"
          >
            <svg
              class="w-5 h-5 text-gray-600 lg:w-8 lg:h-8 dark:text-gray-500"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                fill-rule="evenodd"
                d="M11.293 3.293a1 1 0 0 1 1.414 0l6 6 2 2a1 1 0 0 1-1.414 1.414L19 12.414V19a2 2 0 0 1-2 2h-3a1 1 0 0 1-1-1v-3h-2v3a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2v-6.586l-.293.293a1 1 0 0 1-1.414-1.414l2-2 6-6Z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <p class="mb-2 text-xl font-bold dark:text-white">Address</p>
          <p class="mb-3 text-gray-500 dark:text-gray-400">
            {formattedAddress}
          </p>
          <a
            href={`https://www.google.com/maps/place/Kando+Martial+Arts+Knox/@-37.8656501,145.2531667,16z/data=!3m1!4b1!4m6!3m5!1s0x6ad63d96cb5582c1:0x78a514e8d801ed69!8m2!3d-37.8656501!4d145.2531667!16s%2Fg%2F11fcv9jxpw?entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoKLDEwMDc5MjA3MUgBUAM%3D`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex py-2 px-4 text-sm font-medium text-center rounded-lg border text-primary-500 border-primary-500 hover:text-white hover:bg-primary-500 focus:ring-4 focus:outline-none focus:ring-primary-300 dark:focus:ring-primary-800"
            >Get directions</a
          >
        </div>
      </div>
    </div>
  </section>

  <LocationMap locationName="Boronia" />
</Layout>
