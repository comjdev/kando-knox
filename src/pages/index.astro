---
import KandoInfo from "../components/home/KandoInfo.astro";
import Layout from "../layouts/Layout.astro";
import Program from "../components/shared/Program.astro";
import Team from "../components/home/Team.astro";
import Benefits from "../components/home/Benefits.astro";
import Testimonials from "../components/shared/Testimonials.astro";
import LatestPosts from "../components/shared/LatestPosts.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ScrollAnimations from "../components/home/ScrollAnimations";
import {
  getSportsActivityLocationSchema,
  getReviewSchema,
} from "../utils/schema";
import googleReviews from "../content/testimonials/google-reviews.json";
import { SITE_CONFIG } from "../config";
import { formatMetaDescription } from "../utils/descriptions";
import { getHomePageTitle } from "../utils/titles";
// Get all location names from location files
// TODO: Migrate to getCollection("locations") once fully tested
const allLocations = Object.values(
  import.meta.glob("../content/locations/*.json", { eager: true })
).map((location: any) => location.default);

// Extract unique location names (cities) and sort them
const cities = Array.from(
  new Set(
    allLocations
      .filter((loc: any) => loc.locationName)
      .map((loc: any) => loc.locationName)
  )
).sort() as string[];

// Generate schemas
const sportsActivitySchema = getSportsActivityLocationSchema(cities);

// Generate Review schema from Google reviews
// Use Google Business Profile URL from config, fallback to first review URL
const googleBusinessUrl =
  SITE_CONFIG.googleBusinessUrl || googleReviews[0]?.url || undefined;
const reviewSchema = getReviewSchema(googleReviews, googleBusinessUrl);

// Combine schemas
const schemas = [sportsActivitySchema, reviewSchema];

// Homepage title - custom format to avoid duplicating site name
const pageTitle = getHomePageTitle();
const pageDescription = formatMetaDescription(
  SITE_CONFIG.description,
  undefined,
  [
    "karate classes",
    "Brazilian Jiu-Jitsu",
    "martial arts training",
    "Knox",
    "Boronia",
  ]
);
const pageImage = "/img/about.jpg"; // Use a good homepage image
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="website"
  schemas={schemas}
>
  <!-- H1 for SEO - visually hidden but accessible -->
  <h1 class="sr-only">
    {SITE_CONFIG.title} - Karate & Brazilian Jiu-Jitsu Classes in Knox, Boronia
  </h1>
  <section aria-label="Hero section">
    <HomeHero />
  </section>

  <section aria-label="About Kando Martial Arts">
    <KandoInfo />
  </section>

  <section aria-label="Benefits of martial arts">
    <Benefits />
  </section>

  <section aria-label="Our programs">
    <Program />
  </section>

  <!-- <section aria-label="Our team">
    <Team />
  </section> -->
  <section aria-label="Testimonials">
    <Testimonials />
  </section>

  <section aria-label="Latest blog posts">
    <LatestPosts />
  </section>

  <!-- Scroll animations - loads after page is interactive to avoid conflicts -->
  <ScrollAnimations client:idle />
</Layout>
