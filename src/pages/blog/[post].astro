---
import Layout from "../../layouts/Layout.astro";
import ScrollAnimations from "../../components/home/ScrollAnimations";
import { getBlogPostingSchema } from "../../utils/schema";
import { getBlogPostTitle } from "../../utils/titles";
import { SITE_CONFIG } from "../../config";
import { formatMetaDescription } from "../../utils/descriptions";
import OptimizedImage from "../../components/shared/OptimizedImage.astro";
import { getImageAsset } from "../../utils/imageMap";
import { getImage } from "astro:assets";
// Temporarily using import.meta.glob until Content Collections schema is fully configured
// TODO: Migrate to getCollection("blog") once schema validation passes

export async function getStaticPaths() {
  const posts = Object.values(
    import.meta.glob("../../content/blog/*.md", { eager: true })
  );

  return posts.map((post: any) => ({
    params: { post: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Get current page URL for sharing
const currentUrl = Astro.url.href;

// Format meta description - prioritize metaDescription field, then description
const pageDescription = formatMetaDescription(
  post.frontmatter.metaDescription || post.frontmatter.description,
  post.frontmatter.title,
  ["martial arts", "karate", "BJJ", "Knox"]
);

// Generate page title - use titleTag if provided, otherwise generate from post title
const pageTitle = post.frontmatter.titleTag
  ? post.frontmatter.titleTag
  : getBlogPostTitle(post.frontmatter.title);

// Load all blog posts for sidebar
const allPosts = Object.values(
  import.meta.glob("../../content/blog/*.md", { eager: true })
).map((post: any) => ({
  title: post.frontmatter.title,
  slug: post.frontmatter.slug,
  date: new Date(post.frontmatter.date),
  image:
    post.frontmatter.image ||
    post.frontmatter.featuredImage ||
    "/img/default.jpg",
  description: post.frontmatter.description || "",
}));
const sidebarPostsData = allPosts.filter(
  (p) => p.slug !== post.frontmatter.slug
);

// Sort by date (newest first) and exclude current post, then take first 3
const sidebarPosts = sidebarPostsData
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

// Format date
const formatDate = (dateString: string | Date) => {
  const date = dateString instanceof Date ? dateString : new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Get featured image or use default
const featuredImagePath =
  post.frontmatter.image ||
  post.frontmatter.featuredImage ||
  "/img/default.jpg";

// Resolve to optimized image asset
const featuredImageAsset = getImageAsset(featuredImagePath);
let featuredImageForDisplay: string | typeof featuredImageAsset;
let featuredImageUrl: string; // For schema and meta tags

if (typeof featuredImageAsset === "object" && "src" in featuredImageAsset) {
  // Use the asset directly for OptimizedImage component
  featuredImageForDisplay = featuredImageAsset;
  // Get URL for schema and meta tags
  const optimizedImage = await getImage({
    src: featuredImageAsset,
    format: "webp",
    quality: 80,
  });
  featuredImageUrl = optimizedImage.src.toString();
} else {
  featuredImageForDisplay = featuredImagePath;
  featuredImageUrl = featuredImagePath;
}

// Format date for schema (ISO format)
const formatDateForSchema = (dateString: string | Date) => {
  const date = dateString instanceof Date ? dateString : new Date(dateString);
  return date.toISOString();
};

// Generate BlogPosting schema
const schema = getBlogPostingSchema(
  post.frontmatter.title,
  post.frontmatter.description || post.frontmatter.title,
  post.frontmatter.slug,
  post.frontmatter.date
    ? formatDateForSchema(post.frontmatter.date)
    : undefined,
  undefined, // dateModified - can be added later if needed
  featuredImageUrl
);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={featuredImageUrl}
  type="article"
  url={currentUrl}
  publishedTime={post.frontmatter.date
    ? formatDateForSchema(post.frontmatter.date)
    : undefined}
  author={SITE_CONFIG.title}
  schema={schema}
>
  <main class="pb-16 lg:pb-24 bg-white dark:bg-gray-900 antialiased">
    <header
      class="w-full h-[460px] xl:h-[537px] relative overflow-hidden"
      transition:name={`blog-image-${post.frontmatter.slug}`}
    >
      {typeof featuredImageForDisplay === "object" && "src" in featuredImageForDisplay ? (
        <OptimizedImage
          src={featuredImageForDisplay}
          alt={post.frontmatter.title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          width={1920}
          height={1080}
          quality={85}
          noBackground={true}
        />
      ) : (
        <img
          src={featuredImageForDisplay}
          alt={post.frontmatter.title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      )}
      <div class="absolute inset-0 bg-black/50 z-10"></div>

      <div
        class="relative z-20 px-4 mx-auto w-full max-w-7xl h-full flex flex-col justify-center xl:px-0"
      >
        {
          post.frontmatter.category && (
            <span class="block mb-4 text-gray-300">
              Published in{" "}
              <a href="#" class="font-semibold text-white hover:underline">
                {Array.isArray(post.frontmatter.category)
                  ? post.frontmatter.category.join(", ")
                  : post.frontmatter.category}
              </a>
            </span>
          )
        }
        <h1
          class="mb-4 max-w-4xl text-2xl font-extrabold leading-tight text-white sm:text-3xl lg:text-4xl break-words"
        >
          {post.frontmatter.title}
        </h1>
        {
          post.frontmatter.description && (
            <p class="text-lg font-normal text-gray-300 max-w-4xl leading-relaxed break-words">
              {post.frontmatter.description}
            </p>
          )
        }
      </div>
    </header>

    <div
      class="flex relative z-20 justify-between p-6 -m-36 mx-4 max-w-7xl bg-white dark:bg-gray-800 rounded xl:-m-32 xl:p-9 xl:mx-auto"
    >
      <article
        class="xl:w-[828px] w-full max-w-none format format-sm sm:format-base lg:format-lg format-blue dark:format-invert"
      >
        <div class="flex flex-col lg:flex-row justify-between lg:items-center">
          <div
            class="flex items-center space-x-3 text-gray-500 dark:text-gray-400 text-base mb-2 lg:mb-0"
          >
            {
              post.frontmatter.date && (
                <span>
                  <time
                    class="font-normal text-gray-500 dark:text-gray-400 uppercase"
                    datetime={
                      post.frontmatter.date instanceof Date
                        ? post.frontmatter.date.toISOString()
                        : new Date(post.frontmatter.date).toISOString()
                    }
                    title={formatDate(post.frontmatter.date)}
                  >
                    {formatDate(post.frontmatter.date)}
                  </time>
                </span>
              )
            }
          </div>
          <aside aria-label="Share social media">
            <div class="not-format">
              <button
                id="share-facebook"
                data-tooltip-target="tooltip-facebook"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
                aria-label="Share on Facebook"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 8 19"
                >
                  <path
                    fill-rule="evenodd"
                    d="M6.135 3H8V0H6.135a4.147 4.147 0 0 0-4.142 4.142V6H0v3h2v9.938h3V9h2.021l.592-3H5V3.591A.6.6 0 0 1 5.592 3h.543Z"
                    clip-rule="evenodd"></path>
                </svg>
              </button>
              <div
                id="tooltip-facebook"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share on Facebook
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>

              <button
                id="share-twitter"
                data-tooltip-target="tooltip-twitter"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
                aria-label="Share on X (Twitter)"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill="currentColor"
                    d="M12.186 8.672 18.743.947h-2.927l-5.005 5.9-4.44-5.9H0l7.434 9.876-6.986 8.23h2.927l5.434-6.4 4.82 6.4H20L12.186 8.672Zm-2.267 2.671L8.544 9.515 3.2 2.42h2.2l4.312 5.719 1.375 1.828 5.731 7.613h-2.2l-4.699-6.237Z"
                  ></path>
                </svg>
              </button>
              <div
                id="tooltip-twitter"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share on Twitter
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>

              <button
                id="copy-link"
                data-tooltip-target="tooltip-link"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
                aria-label="Copy link"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 19 19"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11.013 7.962a3.519 3.519 0 0 0-4.975 0l-3.554 3.554a3.518 3.518 0 0 0 4.975 4.975l.461-.46m-.461-4.515a3.518 3.518 0 0 0 4.975 0l3.553-3.554a3.518 3.518 0 0 0-4.974-4.975L10.3 3.7"
                  ></path>
                </svg>
              </button>
              <div
                id="tooltip-link"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share link
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>
            </div>
          </aside>
        </div>

        <post.Content />
      </article>

      <script define:vars={{ currentUrl, pageTitle, pageDescription }}>
        // Share on Facebook
        document
          .getElementById("share-facebook")
          ?.addEventListener("click", () => {
            const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
            window.open(facebookUrl, "_blank", "width=600,height=400");
          });

        // Share on X (Twitter)
        document
          .getElementById("share-twitter")
          ?.addEventListener("click", () => {
            const twitterText = `${pageTitle} - ${pageDescription}`;
            const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(twitterText)}`;
            window.open(twitterUrl, "_blank", "width=600,height=400");
          });

        // Copy link to clipboard
        document
          .getElementById("copy-link")
          ?.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(currentUrl);

              // Update tooltip text temporarily
              const tooltip = document.getElementById("tooltip-link");
              const originalText = tooltip?.textContent || "Share link";

              if (tooltip) {
                tooltip.textContent = "Link copied!";
                tooltip.classList.remove("invisible", "opacity-0");
                tooltip.classList.add("visible", "opacity-100");

                // Reset after 2 seconds
                setTimeout(() => {
                  tooltip.textContent = originalText;
                  tooltip.classList.remove("visible", "opacity-100");
                  tooltip.classList.add("invisible", "opacity-0");
                }, 2000);
              }
            } catch (err) {
              console.error("Failed to copy link:", err);
              // Fallback for older browsers
              const textArea = document.createElement("textarea");
              textArea.value = currentUrl;
              textArea.style.position = "fixed";
              textArea.style.opacity = "0";
              document.body.appendChild(textArea);
              textArea.select();
              try {
                document.execCommand("copy");
                alert("Link copied to clipboard!");
              } catch (fallbackErr) {
                console.error("Fallback copy failed:", fallbackErr);
              }
              document.body.removeChild(textArea);
            }
          });
      </script>

      <aside class="hidden xl:block" aria-labelledby="sidebar-label">
        <div class="xl:w-[336px] sticky top-6">
          <h3 id="sidebar-label" class="sr-only">Sidebar</h3>

          <div class="mb-8">
            <h4
              class="mb-2 text-sm font-bold text-gray-900 dark:text-white uppercase"
            >
              Book Your Trial Today
            </h4>
            <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              Start your martial arts journey with us. Book a trial class and
              discover how we can help you or your child develop confidence,
              discipline, and physical fitness.
            </p>
            <a
              href="#footer-book-trial"
              class="text-white bg-primary-500 hover:bg-primary-600 focus:ring-4 focus:ring-primary-300 font-medium rounded-md text-sm px-5 py-2.5 mr-2 mb-2 focus:outline-none dark:focus:ring-primary-800 text-center w-full inline-block"
            >
              Book a Trial
            </a>
          </div>

          <div class="mb-12">
            <h4
              class="mb-4 text-sm font-bold text-gray-900 dark:text-white uppercase"
            >
              Latest Blog Posts
            </h4>

            {
              sidebarPosts.length > 0 ? (
                sidebarPosts.map((blogPost) => (
                  <div class="mb-6 flex items-center">
                    <a href={`/blog/${blogPost.slug}`} class="shrink-0 mr-4">
                      <OptimizedImage
                        src={blogPost.image}
                        class="max-w-full w-24 h-24 rounded-lg object-cover aspect-square"
                        alt={blogPost.title}
                        loading="lazy"
                        decoding="async"
                        width={192}
                        height={192}
                        quality={95}
                        sizes="96px"
                      />
                    </a>
                    <div>
                      <h5 class="mb-1 font-bold leading-tight dark:text-white text-gray-900">
                        <a href={`/blog/${blogPost.slug}`}>{blogPost.title}</a>
                      </h5>
                      {blogPost.description && (
                        <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
                          {blogPost.description.slice(0, 80)}
                          {blogPost.description.length > 80 ? "..." : ""}
                        </p>
                      )}
                      <a
                        href={`/blog/${blogPost.slug}`}
                        class="inline-flex items-center font-medium underline-offset-4 text-primary-500 hover:underline"
                      >
                        Read more
                      </a>
                    </div>
                  </div>
                ))
              ) : (
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  No other blog posts available.
                </p>
              )
            }
          </div>

          <div>
            <a
              href="/timetable"
              class="flex justify-center items-center mb-3 w-full h-48 bg-gray-100 rounded-lg dark:bg-gray-700 overflow-hidden"
            >
              <OptimizedImage
                src="/img/kando-knox-junior-martial-arts-3.jpg"
                alt="Junior Martial Arts students at Kando Martial Arts Knox"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 768px) 100vw, 400px"
              />
            </a>
            <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
              See our timetable and book your trial class today.
            </p>
            <a
              href="/timetable"
              class="text-xs text-primary-500 uppercase hover:underline"
            >
              Our timetable
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <ScrollAnimations client:idle />
</Layout>
