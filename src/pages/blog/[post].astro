---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = Object.values(
    import.meta.glob("../../content/blog/*.md", { eager: true })
  );

  return posts.map((post: any) => ({
    params: { post: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Load programs for sidebar
const allPrograms = Object.values(
  import.meta.glob("../../content/program/*.json", { eager: true })
).map((program: any) => program.default);

// Sort programs by id and take first 3 for sidebar
const sidebarPrograms = allPrograms.sort((a, b) => a.id - b.id).slice(0, 3);

// Format date
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Get featured image or use default
const featuredImage =
  post.frontmatter.image ||
  post.frontmatter.featuredImage ||
  "/img/default.jpg";
---

<Layout>
  <main class="pb-16 lg:pb-24 bg-white dark:bg-gray-900 antialiased">
    <header
      class="w-full h-[460px] xl:h-[537px] bg-no-repeat bg-cover bg-center relative"
      style={`background-image: url('${featuredImage}'); background-size: cover; background-position: center;`}
      transition:name={`blog-image-${post.frontmatter.slug}`}
    >
      <div class="absolute inset-0 bg-black/50 z-10"></div>

      <div
        class="relative z-20 px-4 mx-auto w-full max-w-7xl h-full flex flex-col justify-center xl:px-0"
      >
        {
          post.frontmatter.category && (
            <span class="block mb-4 text-gray-300">
              Published in{" "}
              <a href="#" class="font-semibold text-white hover:underline">
                {post.frontmatter.category}
              </a>
            </span>
          )
        }
        <h1
          class="mb-4 max-w-4xl text-2xl font-extrabold leading-tight text-white sm:text-3xl lg:text-4xl break-words"
        >
          {post.frontmatter.title}
        </h1>
        {
          post.frontmatter.description && (
            <p class="text-lg font-normal text-gray-300 max-w-4xl leading-relaxed break-words">
              {post.frontmatter.description}
            </p>
          )
        }
      </div>
    </header>

    <div
      class="flex relative z-20 justify-between p-6 -m-36 mx-4 max-w-7xl bg-white dark:bg-gray-800 rounded xl:-m-32 xl:p-9 xl:mx-auto"
    >
      <article
        class="xl:w-[828px] w-full max-w-none format format-sm sm:format-base lg:format-lg format-blue dark:format-invert"
      >
        <div class="flex flex-col lg:flex-row justify-between lg:items-center">
          <div
            class="flex items-center space-x-3 text-gray-500 dark:text-gray-400 text-base mb-2 lg:mb-0"
          >
            {
              post.frontmatter.author && (
                <>
                  <span>
                    By{" "}
                    <a
                      href="#"
                      class="text-gray-900 dark:text-white hover:underline no-underline font-semibold"
                    >
                      {post.frontmatter.author}
                    </a>
                  </span>
                  <span class="bg-gray-300 dark:bg-gray-400 w-2 h-2 rounded-full" />
                </>
              )
            }
            {
              post.frontmatter.date && (
                <span>
                  <time
                    class="font-normal text-gray-500 dark:text-gray-400 uppercase"
                    datetime={post.frontmatter.date}
                    title={formatDate(post.frontmatter.date)}
                  >
                    {formatDate(post.frontmatter.date)}
                  </time>
                </span>
              )
            }
          </div>
          <aside aria-label="Share social media">
            <div class="not-format">
              <button
                data-tooltip-target="tooltip-facebook"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 8 19"
                >
                  <path
                    fill-rule="evenodd"
                    d="M6.135 3H8V0H6.135a4.147 4.147 0 0 0-4.142 4.142V6H0v3h2v9.938h3V9h2.021l.592-3H5V3.591A.6.6 0 0 1 5.592 3h.543Z"
                    clip-rule="evenodd"></path>
                </svg>
              </button>
              <div
                id="tooltip-facebook"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share on Facebook
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>

              <button
                data-tooltip-target="tooltip-twitter"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill="currentColor"
                    d="M12.186 8.672 18.743.947h-2.927l-5.005 5.9-4.44-5.9H0l7.434 9.876-6.986 8.23h2.927l5.434-6.4 4.82 6.4H20L12.186 8.672Zm-2.267 2.671L8.544 9.515 3.2 2.42h2.2l4.312 5.719 1.375 1.828 5.731 7.613h-2.2l-4.699-6.237Z"
                  ></path>
                </svg>
              </button>
              <div
                id="tooltip-twitter"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share on Twitter
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>

              <button
                data-tooltip-target="tooltip-link"
                class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                type="button"
              >
                <svg
                  class="w-5 h-5 text-gray-500 dark:text-gray-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 19 19"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11.013 7.962a3.519 3.519 0 0 0-4.975 0l-3.554 3.554a3.518 3.518 0 0 0 4.975 4.975l.461-.46m-.461-4.515a3.518 3.518 0 0 0 4.975 0l3.553-3.554a3.518 3.518 0 0 0-4.974-4.975L10.3 3.7"
                  ></path>
                </svg>
              </button>
              <div
                id="tooltip-link"
                role="tooltip"
                class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip dark:bg-gray-700"
              >
                Share link
                <div class="tooltip-arrow" data-popper-arrow></div>
              </div>
            </div>
          </aside>
        </div>

        <post.Content />
      </article>

      <aside class="hidden xl:block" aria-labelledby="sidebar-label">
        <div class="xl:w-[336px] sticky top-6">
          <h3 id="sidebar-label" class="sr-only">Sidebar</h3>

          <div class="mb-8">
            <h4
              class="mb-2 text-sm font-bold text-gray-900 dark:text-white uppercase"
            >
              Book Your Trial Today
            </h4>
            <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              Start your martial arts journey with us. Book a trial class and
              discover how we can help you or your child develop confidence,
              discipline, and physical fitness.
            </p>
            <a
              href="#footer-book-trial"
              class="text-white bg-primary-500 hover:bg-primary-600 focus:ring-4 focus:ring-primary-300 font-medium rounded-md text-sm px-5 py-2.5 mr-2 mb-2 focus:outline-none dark:focus:ring-primary-800 text-center w-full inline-block"
            >
              Book a Trial
            </a>
          </div>

          <div class="mb-12">
            <h4
              class="mb-4 text-sm font-bold text-gray-900 dark:text-white uppercase"
            >
              Our Programs
            </h4>

            {
              sidebarPrograms.map((program) => (
                <div class="mb-6 flex items-center">
                  <a href={`/programs/${program.slug}`} class="shrink-0">
                    <img
                      src={program.image || "/img/placeholder.jpg"}
                      class="mr-4 max-w-full w-24 h-24 rounded-lg object-cover"
                      alt={program.title}
                    />
                  </a>
                  <div>
                    <h5 class="mb-1 font-bold leading-tight dark:text-white text-gray-900">
                      <a href={`/programs/${program.slug}`}>{program.title}</a>
                    </h5>
                    <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
                      {program.shortDescription ||
                        program.description?.slice(0, 80)}
                    </p>
                    <a
                      href={`/programs/${program.slug}`}
                      class="inline-flex items-center font-medium underline-offset-4 text-primary-500 hover:underline"
                    >
                      Learn more
                    </a>
                  </div>
                </div>
              ))
            }
          </div>

          <div>
            <a
              href="/timetable"
              class="flex justify-center items-center mb-3 w-full h-48 bg-gray-100 rounded-lg dark:bg-gray-700 overflow-hidden"
            >
              <img
                src="/img/kando-knox-junior-martial-arts-3.jpg"
                alt="Junior Martial Arts students at Kando Martial Arts Knox"
                class="w-full h-full object-cover"
              />
            </a>
            <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
              See our timetable and book your trial class today.
            </p>
            <a
              href="/timetable"
              class="text-xs text-primary-500 uppercase hover:underline"
            >
              Our timetable
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>
